---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import { site } from '../../data/site';
import { visibleListings, showSamples, STATES } from '../../data/directory';

const hasSamples = visibleListings.some((l) => l.sample);
const byState = Object.entries(STATES)
  .map(([code, name]) => ({ code, name, items: visibleListings.filter((l) => l.state === code) }))
  .filter((g) => g.items.length > 0);
---
<Base title="Find a painter" description="Painting businesses that run on Paint Trade HQ, by state and suburb: who they are, where they work and what they do best." noindex={hasSamples}>
  <section class="section section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Directory</span>
        <h1>Find a painter</h1>
        <p class="lead">Painting businesses that run their jobs on Paint Trade HQ, by state. Each one has a page of its own: who they are, where they work and what they do best.</p>
        {hasSamples && (
          <p class="small sample-banner"><span class="pill pill--neutral">Sample listings</span> These show what a listing looks like. Real businesses replace them as painters join.</p>
        )}
      </div>

      {visibleListings.length === 0 && (
        <div class="card empty">
          <h2>Listings open to painting businesses on Paint Trade HQ</h2>
          <p>The first real listings appear here as painters join. If that's you, start your free trial.</p>
          <Button href={site.status.ctaHref}>{site.status.cta}</Button>
        </div>
      )}

      {visibleListings.length > 0 && (
        <>
          <div class="filter" role="group" aria-label="Filter by state" id="state-filter">
            <button type="button" class="filter__btn is-on" data-state="">All <span class="muted">{visibleListings.length}</span></button>
            {byState.map((g) => (
              <button type="button" class="filter__btn" data-state={g.code}>{g.name} <span class="muted">{g.items.length}</span></button>
            ))}
          </div>
          <div class="grid grid--3 listings" id="listings">
            {visibleListings.map((l) => (
              <a class="card listing" href={`/painters/${l.slug}`} data-state={l.state}>
                <div class="listing__top">
                  <span class="pill pill--neutral">{l.state}</span>
                  {l.sample && <span class="pill pill--neutral">Sample</span>}
                </div>
                <h3>{l.name}</h3>
                <p class="small listing__where">{l.suburb} · {l.areas.join(' · ')}</p>
                <ul class="listing__services">
                  {l.services.slice(0, 3).map((s) => <li>{s}</li>)}
                </ul>
                <span class="small listing__more">See the listing</span>
              </a>
            ))}
          </div>
          <p class="small center empty-filter" id="empty-filter" hidden>No listings in that state yet.</p>
        </>
      )}
    </div>
  </section>

  <section class="section section--ink cta">
    <div class="container center">
      <h2>Run a painting business?</h2>
      <p class="lead">A listing here comes with Paint Trade HQ. Start your 30-day free trial and your page is yours to fill in.</p>
      <Button href={site.status.ctaHref} variant="on-ink" size="lg">{site.status.cta}</Button>
    </div>
  </section>
</Base>

<style>
  .sample-banner { display: inline-flex; align-items: center; gap: 10px; flex-wrap: wrap; color: var(--text-2); }
  .filter { display: flex; flex-wrap: wrap; gap: 8px; margin: 28px 0 20px; }
  .filter__btn { font: inherit; font-size: 14px; font-weight: 500; color: var(--text); background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-pill); padding: 6px 14px; cursor: pointer; }
  .filter__btn:hover { border-color: var(--accent); }
  .filter__btn.is-on { background: var(--accent); border-color: var(--accent); color: #fff; }
  .filter__btn.is-on .muted { color: rgba(255, 255, 255, 0.75); }
  .listing { display: flex; flex-direction: column; gap: 8px; color: inherit; }
  .listing:hover { text-decoration: none; border-color: var(--accent); }
  .listing__top { display: flex; gap: 6px; flex-wrap: wrap; }
  .listing h3 { margin: 4px 0 0; }
  .listing[hidden] { display: none; }
  .listing__where { color: var(--text-2); margin: 0; }
  .listing__services { list-style: none; padding: 0; margin: 4px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .listing__services li { font-size: 13px; background: var(--sunken); border: 1px solid var(--border); border-radius: var(--r-pill); padding: 3px 10px; }
  .listing__more { margin-top: auto; color: var(--accent-ink); font-weight: 600; }
  .empty { max-width: 640px; }
  .empty h2 { margin-top: 0; }
  .empty .btn { margin-top: 12px; }
  .cta .lead { margin-left: auto; margin-right: auto; margin-bottom: 24px; }
</style>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('#state-filter .filter__btn'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#listings .listing'));
  const empty = document.getElementById('empty-filter');
  function apply(state: string) {
    buttons.forEach((b) => b.classList.toggle('is-on', (b.dataset.state || '') === state));
    let shown = 0;
    cards.forEach((c) => { const on = !state || c.dataset.state === state; c.hidden = !on; if (on) shown++; });
    if (empty) empty.hidden = shown > 0;
  }
  buttons.forEach((b) => b.addEventListener('click', () => { const st = b.dataset.state || ''; apply(st); history.replaceState(null, '', st ? `#${st.toLowerCase()}` : location.pathname); }));
  const fromHash = location.hash.replace('#', '').toUpperCase();
  if (buttons.some((b) => b.dataset.state === fromHash)) apply(fromHash);
</script>
