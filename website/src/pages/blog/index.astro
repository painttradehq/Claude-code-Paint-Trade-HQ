---
/**
 * The blog index, in the home page's language (31 Oct 2026). What this page has that the others don't: the
 * newest post as a wide ribbon card (the same two bands as the lead card on the home page, unchanged), tag chips
 * that filter the list, and the "notes by email" box from the home page at the end (same function, source=newsletter).
 */
import Base from '../../layouts/Base.astro';
import Reveal from '../../components/Reveal.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.order - b.data.order);
const fmt = (d: Date) => d.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
const anyDraft = posts.some((p) => p.data.draft);
const [lead, ...rest] = posts;
const tags = Array.from(new Set(posts.map((p) => p.data.tag)));
const count = (t: string) => posts.filter((p) => p.data.tag === t).length;
---
<Base title="From the workshop" description="Notes from Paint Trade HQ on quoting, running the crew and getting paid, written by the people building the app." noindex={anyDraft}>
  <section class="bhero">
    <div class="container">
      <h1 class="tone tone--h1 bhero__h"><span class="tone__dark">From the workshop.</span> <span class="tone__light">Short, practical notes on quoting, the crew and getting paid, from the people building the app.</span></h1>
      {anyDraft && <p class="small"><span class="pill pill--neutral">Drafts</span> These posts are drafts awaiting the owner's approval before launch.</p>}
      <div class="chips" role="group" aria-label="Filter by topic" id="tag-filter">
        <button type="button" class="chip is-on" data-tag="" aria-pressed="true">All <span class="chip__n">{posts.length}</span></button>
        {tags.map((t) => <button type="button" class="chip" data-tag={t} aria-pressed="false">{t} <span class="chip__n">{count(t)}</span></button>)}
      </div>
    </div>
  </section>

  <section class="section section--tight" id="posts">
    <div class="container">
      {lead && (
        <a class="lead-card reveal" href={`/blog/${lead.id}`} data-tag={lead.data.tag} data-post>
          <div class="wpost__ribbon" aria-hidden="true"><i></i><i></i></div>
          <div class="lead-card__body">
            <span class="wpost__meta small">{lead.data.tag} · {fmt(lead.data.date)} {lead.data.draft && <span class="pill pill--neutral">Draft</span>}</span>
            <span class="lead-card__title">{lead.data.title}</span>
            <span class="lead-card__sum">{lead.data.summary}</span>
            <span class="lead-card__more">Read it <span aria-hidden="true">→</span></span>
          </div>
        </a>
      )}
      <div class="grid grid--3 posts" id="post-grid">
        {rest.map((p) => (
          <a class="card post reveal" href={`/blog/${p.id}`} data-tag={p.data.tag} data-post>
            {p.data.cover && <img class="post__cover" src={p.data.cover} alt={p.data.coverAlt || ''} loading="lazy" decoding="async" />}
            <div class="post__meta small">{p.data.tag} · {fmt(p.data.date)} {p.data.draft && <span class="pill pill--neutral">Draft</span>}</div>
            <h2>{p.data.title}</h2>
            <p class="small">{p.data.summary}</p>
          </a>
        ))}
      </div>
      <p class="small center" id="empty-filter" hidden>No notes on that topic yet.</p>
    </div>
  </section>

  <!-- Notes by email: the same box as the home page -->
  <section class="section updates" id="updates">
    <div class="container updates__in">
      <div>
        <h2 class="tone updates__h"><span class="tone__dark">Get the notes by email.</span> <span class="tone__light">One email when something ships or a note goes up. Nothing else.</span></h2>
      </div>
      <form class="updates__form" id="updates-form" method="post" action="/api/invite" novalidate>
        <input type="hidden" name="source" value="newsletter" />
        <input type="hidden" name="redirect" value="/trial/sent" />
        <input type="text" name="website" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label class="visually-hidden" for="updates-email">Your email</label>
        <div class="updates__row">
          <input class="input" id="updates-email" name="email" type="email" placeholder="you@yourbusiness.com.au" autocomplete="email" required />
          <button class="btn btn--primary" type="submit" id="updates-submit">Keep me posted <span aria-hidden="true">›</span></button>
        </div>
        <p class="small updates__note" id="updates-note">We read every reply ourselves. Unsubscribe by replying "stop".</p>
      </form>
    </div>
  </section>

  <Reveal />
</Base>

<style>
  .bhero { padding: clamp(36px, 5vw, 64px) 0 8px; background: var(--bg); }
  .bhero__h { font-size: clamp(30px, 3.8vw, 46px); margin-bottom: 16px; max-width: 26ch; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .chip { font: inherit; font-size: 14px; font-weight: 500; color: var(--text); background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-pill); padding: 6px 14px; cursor: pointer; }
  .chip:hover { border-color: var(--accent); }
  .chip.is-on { background: var(--accent); border-color: var(--accent); color: #fff; }
  .chip__n { color: var(--muted); margin-left: 4px; }
  .chip.is-on .chip__n { color: rgba(255, 255, 255, 0.75); }

  /* the lead card: the home page's ribbon card, wide */
  .lead-card { position: relative; display: block; overflow: hidden; border-radius: 18px; background: #2a2150; color: #fff; min-height: 300px; margin-bottom: 16px; transition: transform 160ms ease, box-shadow 160ms ease; }
  .lead-card:hover { text-decoration: none; transform: translateY(-3px); box-shadow: var(--shadow-float); }
  .lead-card[hidden] { display: none; }
  .wpost__ribbon { position: absolute; inset: 0; overflow: hidden; }
  .wpost__ribbon i { position: absolute; display: block; filter: blur(1.5px); }
  .wpost__ribbon i:first-child { left: 45%; top: -50%; width: 50%; height: 200%; border-radius: 50% / 15% 15% 85% 85%; background: linear-gradient(170deg, #34295e, #6b5bb5 40%, #9a8cd8 65%, #cfc3f3); transform: rotate(28deg); opacity: 0.9; }
  .wpost__ribbon i:last-child { left: 70%; top: -40%; width: 14%; height: 180%; border-radius: 50% / 10% 10% 90% 90%; background: linear-gradient(180deg, #e6dffa, #8a79d6 60%, #34295e); transform: rotate(24deg); opacity: 0.8; }
  .lead-card__body { position: relative; z-index: 1; display: grid; gap: 10px; padding: 40px 32px 32px; max-width: 60ch; min-height: 300px; align-content: end; background: linear-gradient(90deg, rgba(42, 33, 80, 0.92) 0%, rgba(42, 33, 80, 0.7) 60%, rgba(42, 33, 80, 0) 100%); }
  .wpost__meta { color: #c3b7ec; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .lead-card__title { font-family: var(--font-display); font-weight: 600; font-size: clamp(26px, 2.8vw, 36px); line-height: 1.15; }
  .lead-card__sum { color: #d6cff0; font-size: 17px; line-height: 1.5; }
  .lead-card__more { color: #fff; font-weight: 600; margin-top: 6px; }

  .posts { align-items: stretch; }
  .post { display: flex; flex-direction: column; gap: 10px; color: inherit; padding: 0; overflow: hidden; }
  .post:hover { text-decoration: none; border-color: var(--accent); }
  .post[hidden] { display: none; }
  .post__cover { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; display: block; border-bottom: 1px solid var(--border); }
  .post__meta { padding: 14px 20px 0; color: var(--text-2); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .post h2 { font-size: 20px; margin: 0; padding: 0 20px; }
  .post p { padding: 0 20px 20px; margin: 0; }

  .updates { background: var(--sunken); }
  .updates__in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px; align-items: center; }
  .updates__h { margin: 0; }
  .updates__row { display: flex; gap: 10px; }
  .updates__row .input { flex: 1 1 auto; min-width: 0; }
  .updates__note { margin: 10px 0 0; color: var(--text-2); }

  @media (max-width: 860px) {
    .updates__in { grid-template-columns: minmax(0, 1fr); }
    .lead-card__body { background: linear-gradient(180deg, rgba(42, 33, 80, 0.2), rgba(42, 33, 80, 0.9) 45%); max-width: none; padding: 60px 22px 22px; }
  }
  @media (max-width: 600px) {
    .updates__row { flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) { .lead-card { transition: none; } }
</style>

<script>
  // Topic chips filter the lead card and the grid together.
  (() => {
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('#tag-filter .chip'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-post]'));
    const empty = document.getElementById('empty-filter');
    const apply = (tag: string) => {
      chips.forEach((c) => { const on = (c.dataset.tag || '') === tag; c.classList.toggle('is-on', on); c.setAttribute('aria-pressed', String(on)); });
      let shown = 0;
      cards.forEach((c) => { const on = !tag || c.dataset.tag === tag; c.hidden = !on; if (on) shown++; });
      if (empty) empty.hidden = shown > 0;
    };
    chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.tag || '')));
  })();

  // Notes by email: same function as the trial form, source=newsletter.
  (() => {
    const form = document.getElementById('updates-form') as HTMLFormElement | null;
    const note = document.getElementById('updates-note');
    const btn = document.getElementById('updates-submit') as HTMLButtonElement | null;
    if (!form || !note || !btn) return;
    form.addEventListener('submit', async (e) => {
      if (!form.checkValidity()) { form.reportValidity(); e.preventDefault(); return; }
      e.preventDefault();
      btn.disabled = true;
      try {
        const res = await fetch('/api/invite', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form).entries())) });
        if (!res.ok) throw new Error(String(res.status));
        note.textContent = "Thanks. You'll hear from us when something ships.";
        form.querySelector<HTMLElement>('.updates__row')?.setAttribute('hidden', '');
      } catch {
        note.textContent = "That didn't send. Email software@joshsano.com.au and we'll add you.";
        btn.disabled = false;
      }
    });
  })();
</script>
