---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={post.data.title} description={post.data.summary} noindex={post.data.draft}>
  <article class="section section--tight">
    <div class="container article">
      <p class="small crumbs"><a href="/blog">From the workshop</a> › {post.data.tag}</p>
      <h1>{post.data.title}</h1>
      <p class="small meta">{fmt(post.data.date)} · Paint Trade HQ {post.data.draft && <span class="pill pill--neutral">Draft, awaiting approval</span>}</p>
      <p class="lead">{post.data.summary}</p>
      {post.data.cover && <img class="cover" src={post.data.cover} alt={post.data.coverAlt || ''} loading="eager" decoding="async" />}
      <div class="prose"><Content /></div>
      <aside class="card card--sunken cta">
        <h3>Try it on your own jobs</h3>
        <p>Every plan starts with a 30-day free trial, no card needed.</p>
        <Button href={site.status.ctaHref}>{site.status.cta}</Button>
      </aside>
    </div>
  </article>
</Base>

<style>
  .article { max-width: 760px; }
  .crumbs { color: var(--text-2); }
  .meta { color: var(--text-2); display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: -6px; }
  .cover { width: 100%; max-height: 420px; object-fit: cover; object-position: top; border-radius: var(--r-lg); border: 1px solid var(--border); margin: 8px 0 24px; display: block; }
  .prose :global(p) { font-size: 17px; line-height: 1.65; }
  .prose :global(ul) { padding-left: 22px; display: grid; gap: 8px; margin: 12px 0 18px; }
  .prose :global(strong) { color: var(--text); }
  .cta { margin-top: 36px; padding: 24px; }
  .cta h3 { margin-top: 0; }
  .cta .btn { margin-top: 8px; }
</style>
