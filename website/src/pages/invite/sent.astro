---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import { site } from '../../data/site';
---
<Base title="Thanks, you're on the list" description="Your invite request for Paint Trade HQ has been sent. Josh reads these himself and will be in touch." noindex>
  <section class="section">
    <div class="container narrow center">
      <span class="eyebrow"><span class="pill">{site.status.pill}</span></span>
      <h1>Thanks, you're on the list.</h1>
      <p class="lead">Josh reads these himself and will be in touch. Invites go out as places open.</p>
      <p class="small">Already have access? <a href={site.signInUrl} rel="noopener">Sign in</a>. Something to add? Email <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>.</p>
      <Button href="/" variant="ghost">Back to the home page</Button>
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 620px; }
  .narrow h1 { margin-top: 12px; }
  .narrow .lead { margin-bottom: 16px; }
  .narrow .small { margin-bottom: 24px; }
</style>
