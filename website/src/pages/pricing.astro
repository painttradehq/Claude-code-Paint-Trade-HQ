---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import PlanCard from '../components/PlanCard.astro';
import Faq from '../components/Faq.astro';
import { site, plans, pricingNotes, pricingToday, statusToday, faqs, trust } from '../data/site';

const pricingFaqs = faqs.filter((f) =>
  ['Is there a free plan?', 'Do I need a card to try it?', 'Does it do GST?', 'How many people can use it?', 'What happens if I stop paying?', 'Can I import my clients from my old software?', 'Can office staff have limited access?', 'Who sees my data?', 'Is my data in Australia?', 'Does it connect to Xero or MYOB?', 'How do I get in?'].includes(f.q),
);
---
<Base title="Pricing" description="Paint Trade HQ plans: Starter $59, Small business $179, Enterprise $249 a month, AUD, ex-GST with 10% GST added. Seats included, extra seats from $15. 14-day trial on Enterprise, no card. Plans open at launch; testers use everything free.">
  <section class="section section--tight">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Pricing</span>
        <h1>Three plans. Monthly. AUD, GST on top.</h1>
        <p class="lead">Prices are a month, ex-GST; 10% GST is added. Monthly only, cancel any time.</p>
        <p class="today"><span class="pill pill--warning">Today</span> {pricingToday}</p>
      </div>
      <div class="grid grid--3 plans">
        {plans.map((p) => <PlanCard plan={p} />)}
      </div>
      <ul class="notes small">
        {pricingNotes.map((n) => <li>{n}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--sunken" id="status">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Said honestly</span>
        <h2>What's live today, and what isn't yet</h2>
        <p class="lead">We would rather tell you now than after you've signed up.</p>
      </div>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Thing</th><th>Status</th><th>In plain words</th></tr></thead>
          <tbody>
            {statusToday.map((s) => (
              <tr>
                <td><strong>{s.thing}</strong></td>
                <td>{s.status}</td>
                <td>{s.say}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Your data</span>
        <h2>Yours, isolated, exportable</h2>
      </div>
      <div class="grid grid--3">
        {trust.map((t) => (
          <article class="card">
            <h3>{t.title}</h3>
            <p>{t.body}</p>
          </article>
        ))}
      </div>
      <p class="small terms">Full terms: <a href={site.termsUrl} rel="noopener">Terms of Service</a> (version 1.2, reviewed by a lawyer for the tester program).</p>
    </div>
  </section>

  <section class="section section--sunken" id="faq">
    <div class="container faq-wrap">
      <div class="section-head">
        <span class="eyebrow">Questions</span>
        <h2>Pricing, data and getting in</h2>
      </div>
      <Faq items={pricingFaqs} />
    </div>
  </section>

  <section class="section section--ink cta">
    <div class="container center">
      <h2>Free while you test it</h2>
      <p class="lead">Invited painting businesses use everything free until their invite ends. Leave your details and Josh will be in touch.</p>
      <Button href={site.status.ctaHref} variant="on-ink" size="lg">{site.status.cta}</Button>
    </div>
  </section>
</Base>

<style>
  .today { display: inline-flex; align-items: center; gap: 10px; margin: 8px auto 0; color: var(--text-2); font-size: 15px; flex-wrap: wrap; justify-content: center; }
  .plans { align-items: stretch; margin-top: 28px; }
  .notes { max-width: 820px; margin: 32px auto 0; padding-left: 20px; display: grid; gap: 8px; }
  .terms { margin-top: 20px; }
  .faq-wrap { max-width: 820px; }
  .cta .lead { margin-left: auto; margin-right: auto; margin-bottom: 24px; }
  section[id] { scroll-margin-top: calc(var(--header-h) + 12px); }
</style>
