---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import { site } from '../../data/site';
---
<Base title="Your trial is on its way" description="Your free trial request for Paint Trade HQ has been sent. Your login arrives by email." noindex>
  <section class="section">
    <div class="container narrow center">
      <span class="eyebrow"><span class="pill">{site.status.pill}</span></span>
      <h1>Thanks, your trial is on its way.</h1>
      <p class="lead">We set up your account and email your login, usually the same business day.</p>
      <p class="small">Already have access? <a href={site.signInUrl} rel="noopener">Sign in</a>. Something to add? Email <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>.</p>
      <Button href="/" variant="ghost">Back to the home page</Button>
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 620px; }
  .narrow h1 { margin-top: 12px; }
  .narrow .lead { margin-bottom: 16px; }
  .narrow .small { margin-bottom: 24px; }
</style>
