---
/**
 * /new — a second home page, built as a prototype beside the current one (which is untouched).
 * Direction: the long-scroll product site with one animated gradient, big type, real product UI floating
 * in cards, a modular product grid and very few words per screen. Our palette and type throughout.
 * Every claim is the same as on the existing pages; the screens are the demo business's real screens
 * (served as WebP from public/screens/webp). Nothing autoplays except the gradient, which stops for
 * reduced-motion and when it scrolls out of view.
 */
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Clip from '../components/Clip.astro';
import Faq from '../components/Faq.astro';
import { site, modules, faqs, testimonials } from '../data/site';
import { clips } from '../data/screens';
import { showSamples } from '../data/directory';

const W = '/screens/webp';
const steps = [
  { id: 'quote', label: 'Quote', caption: 'Built from your Library, room by room.', browser: `${W}/04-quote-builder-1440.webp`, phone: null },
  { id: 'sign', label: 'Sign', caption: 'Signed on their phone. No account, no app.', browser: `${W}/09-review-and-send-1440.webp`, phone: `${W}/10-client-quote-accept-390.webp` },
  { id: 'run', label: 'Run', caption: 'The accepted quote becomes the live job; crew sign in with GPS.', browser: `${W}/16-job-drawer-1440.webp`, phone: `${W}/40-crew-time-clock-390.webp` },
  { id: 'paid', label: 'Paid', caption: 'Invoices follow the payment schedule on the quote.', browser: `${W}/02-dashboard-1440.webp`, phone: `${W}/21-client-invoice-390.webp` },
];

const icons: Record<string, string> = {
  dashboard: 'M4 5h7v6H4zM13 5h7v4h-7zM13 11h7v8h-7zM4 13h7v6H4z',
  library: 'M4 5h5v14H4zM10 5h5v14h-5zM16 6l4-1v14l-4 1z',
  quotes: 'M6 3h9l4 4v14H6zM15 3v4h4M9 12h7M9 16h7',
  projects: 'M12 21s-6-5.5-6-10a6 6 0 0 1 12 0c0 4.5-6 10-6 10zM12 13a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
  timesheets: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2',
  'daily-reports': 'M5 4h14v16H5zM8 9h8M8 13h8M8 17h5',
  invoices: 'M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6',
  calendar: 'M4 6h16v14H4zM4 10h16M8 3v4M16 3v4',
  employees: 'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3 20a6 6 0 0 1 12 0M16 11a3 3 0 1 0 0-6M21 20a6 6 0 0 0-5-5.9',
  'crew-app': 'M8 2h8a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zM11 18h2',
  crm: 'M4 5h16v11H9l-5 4zM8 9h8M8 12h5',
  lucy: 'M12 3l1.8 4.6L18 9l-4.2 1.4L12 15l-1.8-4.6L6 9l4.2-1.4zM19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z',
  files: 'M3 7h6l2 2h10v10H3zM3 7V5h6',
};
const defaultIcon = 'M4 4h16v16H4z';

const tiles = modules.filter((m) => m.id !== 'dashboard');
const homeFaqs = faqs.filter((f) => ['Does it track my crew?', 'Does the client need an account?', 'Is there an app for my phone?', 'Is there a free plan?'].includes(f.q));
const quotes = testimonials.filter((t) => showSamples || !t.sample).slice(0, 3);
const chapters = clips.filter((c) => ['new-quote-to-sent', 'client-accepts-quote', 'crew-clock-in-and-daily-report', 'invoice-payment-to-client-page'].includes(c.id));
---
<Base title="Paint Trade HQ" fullTitle="Paint Trade HQ · Quote it. Run it. Get paid." description={site.description} noindex>
  <!-- Hero on the gradient -->
  <section class="nh" id="top">
    <div class="nh__bg" aria-hidden="true"><canvas id="nh-canvas"></canvas></div>
    <div class="container nh__in">
      <div class="nh__copy">
        <span class="nh__pill">30-day free trial · no card</span>
        <h1 class="nh__h1"><span class="nh__w">Quote it.</span> <span class="nh__w">Run it.</span> <span class="nh__w">Get paid.</span></h1>
        <p class="nh__lead">The quote your client signs on their phone becomes the live job your crew sign in to, and the invoices follow.</p>
        <div class="nh__cta">
          <Button href={site.status.ctaHref} size="lg">{site.status.cta}</Button>
          <a class="nh__ghost" href="#watch">Watch it work <span aria-hidden="true">→</span></a>
        </div>
        <p class="nh__fine">Built in Melbourne for painting businesses. Already in? <a href={site.signInUrl} rel="noopener">Sign in</a>.</p>
      </div>

      <div class="stage" id="stage" data-step="0">
        <div class="stage__tabs" role="tablist" aria-label="How a job runs">
          {steps.map((s, i) => (
            <button type="button" role="tab" class="stage__tab" id={`tab-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`panel-${s.id}`} data-i={i}>
              <span class="stage__bar"><span class="stage__fill"></span></span>
              <span class="stage__label">{s.label}</span>
            </button>
          ))}
        </div>
        <div class="stage__frames">
          {steps.map((s, i) => (
            <div class="stage__panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} data-i={i} hidden={i !== 0}>
              <figure class="stage__browser">
                <span class="stage__dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <img src={s.browser} alt={`${s.label} step in the app`} width="1200" height="750" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              </figure>
              {s.phone && (
                <figure class="stage__phone">
                  <img src={s.phone} alt="" width="560" height="1212" loading="lazy" decoding="async" />
                </figure>
              )}
            </div>
          ))}
        </div>
        <p class="stage__caption small" id="stage-caption">{steps[0].caption}</p>
        <button type="button" class="stage__pause" id="stage-pause" aria-pressed="false" aria-label="Pause the demo">Pause</button>
      </div>
    </div>
  </section>

  <!-- Fact line -->
  <section class="facts" aria-label="Key facts">
    <div class="container facts__in">
      <span>From <strong>$98 + GST</strong> a month</span>
      <span><strong>30-day</strong> free trial, no card</span>
      <span><strong>No app store.</strong> Add it to the home screen</span>
      <span><strong>AUD</strong>, built in Melbourne</span>
    </div>
  </section>

  <!-- Modular grid -->
  <section class="section mod" id="modules">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <span class="eyebrow">One app, in the order a job runs</span>
        <h2>Everything a painting business runs on</h2>
        <p class="lead">Each part feeds the next. Tap one to see what it does.</p>
      </div>
      <div class="tiles">
        {tiles.map((m, i) => (
          <a class="tile reveal" href={`/features#${m.id}`} style={`--d:${(i % 4) * 60}ms`}>
            <span class="tile__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round"><path d={icons[m.id] || defaultIcon} /></svg></span>
            <span class="tile__name">{m.name}</span>
            <span class="tile__sum small">{m.summary}</span>
            {m.plan !== 'Starter' && <span class="tile__plan">{m.plan}+</span>}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Three product moments, alternating -->
  <section class="section section--sunken moment" id="how">
    <div class="container split">
      <div class="reveal">
        <span class="eyebrow">Quote</span>
        <h2>A quote they read, tick and sign on their phone</h2>
        <p class="lead">Built from your own Library, sent as a link. No account, no app, no printer.</p>
        <ul class="checklist">
          <li>Optional extras the client can tick on</li>
          <li>Sign by drawing or typing; the deposit invoice is created for you</li>
          <li>Variations approved the same way, mid-job</li>
        </ul>
        <a class="more" href="/features#quotes">More about quotes <span aria-hidden="true">→</span></a>
      </div>
      <div class="floaters reveal">
        <figure class="float float--browser"><img src={`${W}/09-review-and-send-1440.webp`} alt="Review & Send: the email beside the quote the client sees" width="1200" height="750" loading="lazy" decoding="async" /></figure>
        <figure class="float float--phone"><img src={`${W}/11-client-quote-signature-390.webp`} alt="The Accept this quote dialog with a drawn signature" width="560" height="1212" loading="lazy" decoding="async" /></figure>
      </div>
    </div>
  </section>

  <section class="section moment" id="run">
    <div class="container split split--reverse">
      <div class="reveal">
        <span class="eyebrow">Run</span>
        <h2>Sign in on site. Sign out at knock-off. Nothing in between.</h2>
        <p class="lead">GPS only at those two moments: time, address, distance from the job. The crew see jobs, the clock and reports. Never prices.</p>
        <ul class="checklist">
          <li>Labour cost from the time clock flows into the job</li>
          <li>Daily reports with photos, read and answered by you (Enterprise)</li>
          <li>A completion report the client receives, with photos</li>
        </ul>
        <a class="more" href="/features#projects">More about live jobs <span aria-hidden="true">→</span></a>
      </div>
      <div class="floaters floaters--left reveal">
        <figure class="float float--browser"><img src={`${W}/16-job-drawer-1440.webp`} alt="A live job: the site on a map, the client, the crew and the project drawer" width="1200" height="750" loading="lazy" decoding="async" /></figure>
        <figure class="float float--phone"><img src={`${W}/40-crew-time-clock-390.webp`} alt="The crew time clock on a phone, signed in since 9:16 am" width="560" height="1212" loading="lazy" decoding="async" /></figure>
      </div>
    </div>
  </section>

  <section class="section section--sunken moment" id="paid">
    <div class="container split">
      <div class="reveal">
        <span class="eyebrow">Get paid</span>
        <h2>Invoices that follow the quote</h2>
        <p class="lead">Deposit, progress and final, each with a public page and a PDF with your bank details. Record the payment and the balance updates.</p>
        <ul class="checklist">
          <li>Credit notes, payment reminders, review requests</li>
          <li>Overtime and payroll CSV from the Timesheets page (Small business and up)</li>
          <li>Clients pay by bank transfer; the app never takes their card</li>
        </ul>
        <a class="more" href="/features#invoices">More about invoices <span aria-hidden="true">→</span></a>
      </div>
      <div class="floaters reveal">
        <figure class="float float--browser"><img src={`${W}/17-timesheets-week-1440.webp`} alt="Timesheets: a pay-week grid with regular and overtime hours" width="1200" height="750" loading="lazy" decoding="async" /></figure>
        <figure class="float float--phone"><img src={`${W}/21-client-invoice-390.webp`} alt="The invoice as the client sees it on a phone" width="560" height="1212" loading="lazy" decoding="async" /></figure>
      </div>
    </div>
  </section>

  <!-- Watch it work: one player, four chapters -->
  <section class="section watch" id="watch">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Watch it work</span>
        <h2>Four short walkthroughs, no sound</h2>
      </div>
      <div class="watch__in">
        <ol class="chapters" id="chapters">
          {chapters.map((c, i) => (
            <li><button type="button" class={`chapter ${i === 0 ? 'is-on' : ''}`} data-i={i} aria-pressed={i === 0 ? 'true' : 'false'}><span class="chapter__n mono">{String(i + 1).padStart(2, '0')}</span><span class="chapter__t">{c.title}</span><span class="chapter__d mono">{Math.floor(c.seconds / 60)}:{String(c.seconds % 60).padStart(2, '0')}</span></button></li>
          ))}
        </ol>
        <div class="player" id="player">
          {chapters.map((c, i) => (
            <div class="player__slot" data-i={i} hidden={i !== 0}><Clip id={c.id} /></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Lucy -->
  <section class="section section--ink lucy">
    <div class="container split">
      <div class="reveal">
        <span class="eyebrow" style="color:#c9bff0">Lucy, the AI assistant</span>
        <h2>Drafts, briefs and summaries from your own data</h2>
        <div class="pills">
          <span class="lpill">Your data only</span>
          <span class="lpill">Drafts you check</span>
          <span class="lpill">Never trains models</span>
        </div>
        <p class="small lucy__fine">Runs on Anthropic's Claude. Every call in your audit log. Small business and up; the crew have no AI features.</p>
      </div>
      <figure class="float float--browser reveal"><img src={`${W}/32-lucy-on-quote-1440.webp`} alt="Lucy open beside a quote, answering with her sources" width="1200" height="750" loading="lazy" decoding="async" /></figure>
    </div>
  </section>

  <!-- Feedback (samples until real ones exist) -->
  {quotes.length > 0 && (
    <section class="section fb" id="feedback">
      <div class="container">
        <div class="section-head section-head--center reveal">
          <span class="eyebrow">From painters</span>
          <h2>What painters say</h2>
          {quotes.some((t) => t.sample) && <p class="small">Sample quotes, to show the layout. Real feedback replaces them as it comes in.</p>}
        </div>
        <div class="fb__row">
          {quotes.map((t) => (
            <figure class="fb__card reveal">
              {t.sample && <span class="pill pill--neutral">Sample</span>}
              <blockquote><p>{t.quote}</p></blockquote>
              <figcaption class="small"><strong>{t.who}</strong> · {t.where}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ, four only -->
  <section class="section section--sunken">
    <div class="container faq-wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Straight answers</span>
        <h2>Questions painters ask</h2>
      </div>
      <Faq items={homeFaqs} openFirst />
      <p class="small"><a href="/pricing#faq">More answers on the pricing page</a></p>
    </div>
  </section>

  <!-- Closing CTA on the gradient -->
  <section class="nend">
    <div class="nend__bg" aria-hidden="true"></div>
    <div class="container center nend__in">
      <h2>Try it on your own jobs</h2>
      <p class="lead">30 days free on every plan. No card. Leave your details and your login arrives by email.</p>
      <Button href={site.status.ctaHref} size="lg">{site.status.cta}</Button>
    </div>
  </section>

  <!-- Sticky phone bar -->
  <div class="sticky" id="sticky" hidden>
    <span class="small">30 days free · no card</span>
    <Button href={site.status.ctaHref} size="sm">{site.status.cta}</Button>
  </div>
</Base>

<style>
  /* ---------- hero ---------- */
  .nh { position: relative; overflow: hidden; padding: clamp(36px, 6vw, 84px) 0 clamp(120px, 14vw, 180px); color: var(--text); }
  .nh__bg { position: absolute; inset: 0; clip-path: polygon(0 0, 100% 0, 100% 82%, 0 100%); background: linear-gradient(135deg, #f1eefa, #e4ddf7 45%, #f6e4d6); }
  .nh__bg canvas { width: 100%; height: 100%; display: block; }
  .nh__in { position: relative; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(28px, 5vw, 56px); align-items: center; }
  .nh__pill { display: inline-block; font-size: 13px; font-weight: 600; letter-spacing: 0.01em; color: var(--accent-ink); background: rgba(255, 255, 255, 0.7); border: 1px solid rgba(75, 62, 134, 0.18); border-radius: var(--r-pill); padding: 6px 12px; backdrop-filter: blur(6px); }
  .nh__h1 { font-size: clamp(44px, 6.6vw, 84px); line-height: 0.98; letter-spacing: -0.02em; margin: 18px 0 18px; }
  .nh__w { display: inline-block; white-space: nowrap; animation: rise 600ms cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .nh__w:nth-child(2) { animation-delay: 120ms; }
  .nh__w:nth-child(3) { animation-delay: 240ms; }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  .nh__lead { font-size: clamp(17px, 1.6vw, 21px); color: var(--text-2); max-width: 34ch; margin: 0 0 24px; }
  .nh__cta { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }
  .nh__ghost { font-weight: 600; color: var(--accent-ink); }
  .nh__ghost:hover { text-decoration: none; color: var(--accent); }
  .nh__fine { margin-top: 18px; font-size: 14px; color: var(--text-2); }

  /* ---------- stage ---------- */
  .stage { position: relative; }
  .stage__tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 14px; }
  .stage__tab { font: inherit; background: none; border: 0; padding: 0; cursor: pointer; text-align: left; color: var(--text-2); display: grid; gap: 8px; }
  .stage__tab[aria-selected='true'] { color: var(--accent-ink); }
  .stage__bar { display: block; height: 3px; border-radius: 3px; background: rgba(75, 62, 134, 0.18); overflow: hidden; }
  .stage__fill { display: block; height: 100%; width: 0; background: var(--accent); }
  .stage__tab[aria-selected='true'] .stage__fill { width: 100%; transition: width var(--stage-ms, 4000ms) linear; }
  .stage[data-paused] .stage__tab[aria-selected='true'] .stage__fill { transition: none; width: 100%; }
  .stage__label { font-size: 13px; font-weight: 600; letter-spacing: 0.02em; }
  .stage__frames { position: relative; }
  .stage__panel { position: relative; }
  .stage__browser { margin: 0; background: #fff; border: 1px solid rgba(30, 28, 26, 0.08); border-radius: 14px; overflow: hidden; box-shadow: 0 30px 60px -20px rgba(52, 41, 94, 0.35), 0 10px 24px -12px rgba(0, 0, 0, 0.2); }
  .stage__dots { display: flex; gap: 6px; padding: 10px 12px; background: var(--sunken); border-bottom: 1px solid var(--border); }
  .stage__dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--border-strong); }
  .stage__browser img { display: block; width: 100%; height: auto; }
  .stage__phone { position: absolute; right: -4%; bottom: -10%; width: 26%; margin: 0; border-radius: 22px; border: 5px solid #1e1c1a; background: #1e1c1a; overflow: hidden; box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.45); aspect-ratio: 9 / 19.5; }
  .stage__phone img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .stage__panel:not([hidden]) { animation: fadein 400ms ease both; }
  @keyframes fadein { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .stage__caption { margin: 22px 0 0; color: var(--text-2); min-height: 1.4em; }
  .stage__pause { position: absolute; top: -34px; right: 0; font: inherit; font-size: 12px; font-weight: 600; color: var(--accent-ink); background: rgba(255, 255, 255, 0.7); border: 1px solid rgba(75, 62, 134, 0.18); border-radius: var(--r-pill); padding: 3px 10px; cursor: pointer; }
  .stage__pause[aria-pressed='true']::after { content: 'd'; }

  /* ---------- facts ---------- */
  .facts { background: var(--surface); border-bottom: 1px solid var(--border); margin-top: calc(-1 * clamp(60px, 8vw, 100px)); position: relative; }
  .facts__in { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; padding: 22px 0; font-size: 15px; color: var(--text-2); }
  .facts__in strong { color: var(--text); }

  /* ---------- tiles ---------- */
  .tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 8px; }
  .tile { position: relative; display: grid; gap: 8px; align-content: start; padding: 18px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); color: inherit; transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease; }
  .tile:hover { text-decoration: none; transform: translateY(-3px); box-shadow: var(--shadow-float); border-color: rgba(75, 62, 134, 0.35); }
  .tile__icon { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: var(--accent-bg); color: var(--accent); }
  .tile__name { font-family: var(--font-display); font-weight: 600; font-size: 18px; line-height: 1.2; }
  .tile__sum { color: var(--text-2); }
  .tile__plan { position: absolute; top: 14px; right: 14px; font-size: 11px; font-weight: 600; color: var(--accent-ink); background: var(--accent-bg); border-radius: var(--r-pill); padding: 2px 8px; }

  /* ---------- moments ---------- */
  .moment h2 { max-width: 16ch; }
  .more { display: inline-block; margin-top: 14px; font-weight: 600; color: var(--accent-ink); }
  .floaters { position: relative; padding: 6% 10% 10% 0; }
  .floaters--left { padding: 6% 0 10% 10%; }
  .floaters::before { content: ''; position: absolute; inset: 10% 0 0 10%; border-radius: 40px; background: radial-gradient(60% 60% at 50% 40%, rgba(75, 62, 134, 0.18), transparent 70%); filter: blur(10px); z-index: 0; }
  .float { position: relative; z-index: 1; margin: 0; background: #fff; border: 1px solid rgba(30, 28, 26, 0.08); border-radius: 14px; overflow: hidden; box-shadow: 0 30px 60px -20px rgba(52, 41, 94, 0.35), 0 10px 24px -12px rgba(0, 0, 0, 0.2); }
  .float img { display: block; width: 100%; height: auto; }
  .floaters .float--phone { position: absolute; right: 0; bottom: 0; width: 26%; border-radius: 22px; border: 5px solid #1e1c1a; background: #1e1c1a; aspect-ratio: 9 / 19.5; }
  .floaters--left .float--phone { right: auto; left: 0; }
  .float--phone img { height: 100%; object-fit: cover; object-position: top; }

  /* ---------- watch ---------- */
  .watch__in { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(20px, 4vw, 40px); align-items: start; }
  .chapters { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .chapter { width: 100%; display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: center; text-align: left; font: inherit; padding: 14px 16px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md); cursor: pointer; color: var(--text); }
  .chapter:hover { border-color: rgba(75, 62, 134, 0.35); }
  .chapter.is-on { border-color: var(--accent); background: var(--accent-bg); }
  .chapter__n { font-size: 12px; color: var(--muted); }
  .chapter__t { font-weight: 600; }
  .chapter__d { font-size: 12px; color: var(--text-2); }
  .player__slot[hidden] { display: none; }

  /* ---------- lucy ---------- */
  .pills { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0; }
  .lpill { font-size: 14px; font-weight: 600; padding: 8px 14px; border-radius: var(--r-pill); background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.25); color: #fff; }
  .lucy__fine { color: rgba(255, 255, 255, 0.72); }
  .lucy .float { border-color: rgba(255, 255, 255, 0.12); }

  /* ---------- feedback ---------- */
  .fb__row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .fb__card { margin: 0; display: grid; gap: 12px; padding: 22px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); }
  .fb__card .pill { justify-self: start; }
  .fb__card blockquote { margin: 0; font-family: var(--font-display); font-size: 19px; line-height: 1.4; }
  .fb__card blockquote p { margin: 0; }
  .faq-wrap { max-width: 820px; }

  /* ---------- closing ---------- */
  .nend { position: relative; overflow: hidden; padding: clamp(72px, 10vw, 128px) 0; }
  .nend__bg { position: absolute; inset: 0; clip-path: polygon(0 18%, 100% 0, 100% 100%, 0 100%); background: linear-gradient(120deg, #f6e4d6, #e4ddf7 50%, #f1eefa); }
  .nend__in { position: relative; }
  .nend .lead { margin: 10px auto 24px; }

  /* ---------- sticky bar ---------- */
  .sticky { display: none; }

  /* ---------- reveal ---------- */
  html.js .reveal { opacity: 0; transform: translateY(14px); transition: opacity 500ms ease var(--d, 0ms), transform 500ms ease var(--d, 0ms); }
  html.js .reveal.is-in { opacity: 1; transform: none; }

  @media (max-width: 1024px) {
    .tiles { grid-template-columns: repeat(3, 1fr); }
    .facts__in { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 860px) {
    .nh { padding-bottom: 96px; }
    .nh__in { grid-template-columns: minmax(0, 1fr); }
    .nh__bg { clip-path: polygon(0 0, 100% 0, 100% 92%, 0 100%); }
    .stage__phone { width: 30%; right: 2%; bottom: -8%; }
    .stage__pause { top: auto; bottom: -4px; }
    .facts { margin-top: -40px; }
    .watch__in { grid-template-columns: minmax(0, 1fr); }
    .chapters { grid-template-columns: 1fr 1fr; }
    .fb__row { grid-template-columns: minmax(0, 1fr); }
    .sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px max(16px, env(safe-area-inset-left, 0px)) calc(10px + env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-right, 0px)); background: rgba(255, 255, 255, 0.92); border-top: 1px solid var(--border); backdrop-filter: blur(8px); }
    .sticky[hidden] { display: none; }
  }
  @media (max-width: 600px) {
    .tiles { grid-template-columns: repeat(2, 1fr); }
    .chapters { grid-template-columns: 1fr; }
    .facts__in { grid-template-columns: 1fr; gap: 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nh__w, .stage__panel:not([hidden]) { animation: none; }
    .stage__tab[aria-selected='true'] .stage__fill { transition: none; }
    html.js .reveal { opacity: 1; transform: none; transition: none; }
    .tile { transition: none; }
  }
</style>

<script>
  document.documentElement.classList.add('js');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- animated gradient (2D canvas, tiny buffer scaled up; stops offscreen and under reduced motion)
  (() => {
    const canvas = document.getElementById('nh-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const W = 64, H = 40;
    canvas.width = W; canvas.height = H;
    const blobs = [
      { c: [75, 62, 134], r: 26, x: 0.75, y: 0.35, dx: 0.18, dy: 0.12, p: 0 },
      { c: [154, 140, 216], r: 30, x: 0.3, y: 0.7, dx: 0.14, dy: 0.1, p: 2 },
      { c: [246, 214, 184], r: 24, x: 0.2, y: 0.2, dx: 0.12, dy: 0.16, p: 4 },
      { c: [233, 223, 255], r: 34, x: 0.6, y: 0.85, dx: 0.1, dy: 0.08, p: 1 },
    ];
    let t = 0, running = true, raf = 0;
    const draw = () => {
      ctx.fillStyle = '#f1eefa';
      ctx.fillRect(0, 0, W, H);
      for (const b of blobs) {
        const x = (b.x + Math.sin(t * b.dx + b.p) * 0.18) * W;
        const y = (b.y + Math.cos(t * b.dy + b.p) * 0.18) * H;
        const g = ctx.createRadialGradient(x, y, 0, x, y, b.r);
        g.addColorStop(0, `rgba(${b.c[0]},${b.c[1]},${b.c[2]},0.85)`);
        g.addColorStop(1, `rgba(${b.c[0]},${b.c[1]},${b.c[2]},0)`);
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, W, H);
      }
    };
    const loop = () => { if (!running) return; t += 0.016; draw(); raf = requestAnimationFrame(loop); };
    draw();
    if (reduced) return;
    const io = new IntersectionObserver(([e]) => { running = e.isIntersecting && !document.hidden; if (running) { cancelAnimationFrame(raf); loop(); } });
    io.observe(canvas);
    document.addEventListener('visibilitychange', () => { running = !document.hidden; if (running) { cancelAnimationFrame(raf); loop(); } });
  })();

  // ---- the four-step stage
  (() => {
    const stage = document.getElementById('stage');
    if (!stage) return;
    const tabs = Array.from(stage.querySelectorAll<HTMLButtonElement>('.stage__tab'));
    const panels = Array.from(stage.querySelectorAll<HTMLElement>('.stage__panel'));
    const caption = document.getElementById('stage-caption');
    const pauseBtn = document.getElementById('stage-pause') as HTMLButtonElement | null;
    const captions = ['Built from your Library, room by room.', 'Signed on their phone. No account, no app.', 'The accepted quote becomes the live job; crew sign in with GPS.', 'Invoices follow the payment schedule on the quote.'];
    const MS = 4000;
    let i = 0, timer = 0, paused = reduced, userPaused = false;
    const show = (n: number) => {
      i = (n + tabs.length) % tabs.length;
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); const f = t.querySelector<HTMLElement>('.stage__fill'); if (f) { f.style.transition = 'none'; f.style.width = k < i ? '100%' : '0'; void f.offsetWidth; if (k === i && !paused) { f.style.transition = `width ${MS}ms linear`; f.style.width = '100%'; } } });
      panels.forEach((p, k) => { p.hidden = k !== i; });
      if (caption) caption.textContent = captions[i];
    };
    const schedule = () => { clearTimeout(timer); if (!paused) timer = window.setTimeout(() => { show(i + 1); schedule(); }, MS); };
    const setPaused = (v: boolean) => { paused = v || userPaused || reduced; stage.toggleAttribute('data-paused', paused); if (paused) clearTimeout(timer); else { show(i); schedule(); } };
    tabs.forEach((t) => t.addEventListener('click', () => { userPaused = true; if (pauseBtn) { pauseBtn.setAttribute('aria-pressed', 'true'); } setPaused(true); show(Number(t.dataset.i)); }));
    stage.addEventListener('mouseenter', () => setPaused(true));
    stage.addEventListener('mouseleave', () => setPaused(false));
    stage.addEventListener('focusin', () => setPaused(true));
    stage.addEventListener('focusout', () => setPaused(false));
    stage.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') { userPaused = true; show(i + 1); } if (e.key === 'ArrowLeft') { userPaused = true; show(i - 1); } });
    pauseBtn?.addEventListener('click', () => { userPaused = !userPaused; pauseBtn.setAttribute('aria-pressed', String(userPaused)); setPaused(userPaused); });
    document.addEventListener('visibilitychange', () => setPaused(document.hidden));
    const io = new IntersectionObserver(([e]) => setPaused(!e.isIntersecting));
    io.observe(stage);
    // Still for the first beat so the headline reads before anything moves.
    window.setTimeout(() => { if (!paused) { show(0); schedule(); } }, 1200);
  })();

  // ---- scroll reveals
  (() => {
    const els = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
    if (reduced || !('IntersectionObserver' in window)) { els.forEach((e) => e.classList.add('is-in')); return; }
    const io = new IntersectionObserver((entries) => { entries.forEach((e) => { if (e.isIntersecting) { (e.target as HTMLElement).classList.add('is-in'); io.unobserve(e.target); } }); }, { rootMargin: '-8% 0px' });
    els.forEach((e) => io.observe(e));
  })();

  // ---- one player, four chapters
  (() => {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('#chapters .chapter'));
    const slots = Array.from(document.querySelectorAll<HTMLElement>('#player .player__slot'));
    buttons.forEach((b) => b.addEventListener('click', () => {
      const n = Number(b.dataset.i);
      buttons.forEach((x, k) => { x.classList.toggle('is-on', k === n); x.setAttribute('aria-pressed', String(k === n)); });
      slots.forEach((s, k) => { s.hidden = k !== n; if (k !== n) s.querySelector('video')?.pause(); });
    }));
  })();

  // ---- sticky bar on phones once the hero buttons scroll away; hidden near the closing CTA
  (() => {
    const bar = document.getElementById('sticky');
    const hero = document.querySelector('.nh__cta');
    const end = document.querySelector('.nend');
    if (!bar || !hero || !end) return;
    let pastHero = false, nearEnd = false;
    const update = () => { bar.hidden = !(pastHero && !nearEnd); };
    new IntersectionObserver(([e]) => { pastHero = !e.isIntersecting && e.boundingClientRect.top < 0; update(); }).observe(hero);
    new IntersectionObserver(([e]) => { nearEnd = e.isIntersecting; update(); }).observe(end);
  })();
</script>
