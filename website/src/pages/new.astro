---
/**
 * /new — a second home page, built beside the current one (which is untouched).
 * Pattern from Josh's reference screenshots (30 Oct 2026): a white page with one vivid ribbon sweeping
 * through the hero, a two-tone sentence headline, then a bento grid of cards with real product UI
 * composed inside each, a soft colour wash in one corner and an expand button that opens the full
 * screen. Our palette (purple, lavender, peach) and our type (Fraunces, Inter) throughout.
 * Claims are the same as on the existing pages. Screens are the demo business's, served as WebP.
 * The ribbon drifts slowly in CSS and stops under reduced motion; nothing else moves on its own
 * except the quote→sign→run→paid stage in the first card, which pauses on hover, focus, tap or
 * when it scrolls out of view.
 */
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Clip from '../components/Clip.astro';
import Faq from '../components/Faq.astro';
import { site, modules, faqs, testimonials } from '../data/site';
import { clips } from '../data/screens';
import { showSamples } from '../data/directory';

const W = '/screens/webp';
const steps = [
  { id: 'quote', label: 'Quote', caption: 'Built from your Library, room by room.', browser: `${W}/04-quote-builder-1440.webp`, phone: null },
  { id: 'sign', label: 'Sign', caption: 'Signed on their phone. No account, no app.', browser: `${W}/09-review-and-send-1440.webp`, phone: `${W}/10-client-quote-accept-390.webp` },
  { id: 'run', label: 'Run', caption: 'The accepted quote becomes the live job; crew sign in with GPS.', browser: `${W}/16-job-drawer-1440.webp`, phone: `${W}/40-crew-time-clock-390.webp` },
  { id: 'paid', label: 'Paid', caption: 'Invoices follow the payment schedule on the quote.', browser: `${W}/02-dashboard-1440.webp`, phone: `${W}/21-client-invoice-390.webp` },
];

/** Bento cards. `full` is the screen the expand button opens. */
const cards = [
  { id: 'crew', title: 'Crew sign in on site, sign out at knock-off', line: 'GPS at those two moments only. Never prices.', href: '/features#timesheets', full: `${W}/40-crew-time-clock-390.webp`, fullAlt: 'The crew time clock on a phone', plan: '' },
  { id: 'invoices', title: 'Invoices that follow the quote', line: 'Deposit, progress, final. Bank transfer, never a card.', href: '/features#invoices', full: `${W}/21-client-invoice-390.webp`, fullAlt: 'The invoice as the client sees it on a phone', plan: '' },
  { id: 'lucy', title: 'Lucy, the AI assistant', line: 'Drafts, briefs and summaries from your own data.', href: '/features#lucy', full: `${W}/32-lucy-on-quote-1440.webp`, fullAlt: 'Lucy open beside a quote, answering with her sources', plan: 'Small business+' },
  { id: 'timesheets', title: 'Timesheets to payroll', line: 'Approve the week, lock it, export the CSV.', href: '/features#timesheets', full: `${W}/17-timesheets-week-1440.webp`, fullAlt: 'Timesheets: a pay-week grid with regular and overtime hours', plan: 'Small business+' },
  { id: 'jobs', title: 'Every live job on one page', line: 'Site on a map, crew, photos, variations, the completion report.', href: '/features#projects', full: `${W}/16-job-drawer-1440.webp`, fullAlt: 'A live job: the site on a map, the client, the crew and the project drawer', plan: '' },
];
const more = modules.filter((m) => !['dashboard', 'quotes', 'timesheets', 'invoices', 'lucy', 'projects'].includes(m.id));

const homeFaqs = faqs.filter((f) => ['Does it track my crew?', 'Does the client need an account?', 'Is there an app for my phone?', 'Is there a free plan?'].includes(f.q));
const quotes = testimonials.filter((t) => showSamples || !t.sample).slice(0, 3);
const chapters = clips.filter((c) => ['new-quote-to-sent', 'client-accepts-quote', 'crew-clock-in-and-daily-report', 'invoice-payment-to-client-page'].includes(c.id));
---
<Base title="Paint Trade HQ" fullTitle="Paint Trade HQ · Quote it. Run it. Get paid." description={site.description} noindex>
  <!-- Hero: white page, one ribbon -->
  <section class="nh" id="top">
    <div class="ribbon" aria-hidden="true"><i class="ribbon__a"></i><i class="ribbon__b"></i><i class="ribbon__c"></i><i class="ribbon__d"></i></div>
    <div class="container nh__in">
      <p class="nh__kicker">Built in Melbourne for painting businesses</p>
      <h1 class="nh__h1">
        <span class="nh__dark">Quote it. Run it. Get paid.</span>
        <span class="nh__light">The quote your client signs on their phone becomes the job your crew sign in to, and the invoices follow.</span>
      </h1>
      <div class="nh__cta">
        <Button href={site.status.ctaHref} size="lg">{site.status.cta} <span aria-hidden="true">›</span></Button>
        <a class="btn btn--ghost btn--lg nh__ghostbtn" href="#watch">Watch it work</a>
      </div>
      <p class="nh__fine">30 days free on every plan. No card. Already in? <a href={site.signInUrl} rel="noopener">Sign in</a>.</p>
    </div>
  </section>

  <!-- Fact strip where the reference has its logo row -->
  <section class="facts" aria-label="Key facts">
    <div class="container facts__in">
      <span>From <strong>$98 + GST</strong> a month</span>
      <span><strong>30-day</strong> free trial</span>
      <span><strong>No app store</strong> needed</span>
      <span><strong>AUD</strong>, GST on top</span>
      <span>Built by a <strong>painter</strong></span>
    </div>
  </section>

  <!-- Bento -->
  <section class="section bento" id="how">
    <div class="container">
      <h2 class="bento__h reveal"><span class="nh__dark">Everything a painting business runs on.</span> <span class="nh__light">Each part feeds the next, so nothing is typed twice.</span></h2>

      <div class="grid12">
        <!-- A: the stage -->
        <article class="bcard bcard--a reveal" id="stage" data-step="0">
          <div class="bcard__head">
            <h3>From quote to signed, on their phone</h3>
            <button type="button" class="expand" data-full={`${W}/09-review-and-send-1440.webp`} data-alt="Review & Send: the email beside the quote the client sees" aria-label="Open the full screen"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-7 7M10 20H4v-6M4 20l7-7" /></svg></button>
          </div>
          <div class="bcard__wash bcard__wash--a" aria-hidden="true"></div>
          <div class="stage__tabs" role="tablist" aria-label="How a job runs">
            {steps.map((s, i) => (
              <button type="button" role="tab" class="stage__tab" id={`tab-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`panel-${s.id}`} data-i={i}>
                <span class="stage__bar"><span class="stage__fill"></span></span>
                <span class="stage__label">{s.label}</span>
              </button>
            ))}
          </div>
          <div class="stage__frames">
            {steps.map((s, i) => (
              <div class="stage__panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} data-i={i} hidden={i !== 0}>
                <figure class="mock mock--browser">
                  <span class="mock__dots" aria-hidden="true"><i></i><i></i><i></i></span>
                  <img src={s.browser} alt={`${s.label} step in the app`} width="1200" height="750" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                </figure>
                {s.phone && <figure class="mock mock--phone stage__phone"><img src={s.phone} alt="" width="560" height="1212" loading="lazy" decoding="async" /></figure>}
              </div>
            ))}
          </div>
          <p class="stage__caption small" id="stage-caption">{steps[0].caption}</p>
          <button type="button" class="stage__pause" id="stage-pause" aria-pressed="false" aria-label="Pause the demo">Pause</button>
        </article>

        <!-- B: crew, tall -->
        <article class="bcard bcard--b reveal">
          <div class="bcard__head">
            <h3>{cards[0].title}</h3>
            <button type="button" class="expand" data-full={cards[0].full} data-alt={cards[0].fullAlt} aria-label="Open the full screen"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-7 7M10 20H4v-6M4 20l7-7" /></svg></button>
          </div>
          <p class="bcard__line">{cards[0].line}</p>
          <div class="bcard__wash bcard__wash--b" aria-hidden="true"></div>
          <figure class="mock mock--phone bcard__phone"><img src={`${W}/40-crew-time-clock-390.webp`} alt="The crew time clock: signed in since 9:16 am, with the job and a Sign out button" width="560" height="1212" loading="lazy" decoding="async" /></figure>
          <a class="bcard__more" href={cards[0].href}>How the crew app works <span aria-hidden="true">→</span></a>
        </article>

        <!-- C: invoices -->
        <article class="bcard bcard--c reveal">
          <div class="bcard__head">
            <h3>{cards[1].title}</h3>
            <button type="button" class="expand" data-full={cards[1].full} data-alt={cards[1].fullAlt} aria-label="Open the full screen"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-7 7M10 20H4v-6M4 20l7-7" /></svg></button>
          </div>
          <p class="bcard__line">{cards[1].line}</p>
          <div class="bcard__wash bcard__wash--c" aria-hidden="true"></div>
          <figure class="mock mock--phone bcard__phone bcard__phone--low"><img src={`${W}/21-client-invoice-390.webp`} alt="The invoice as the client sees it on a phone" width="560" height="1212" loading="lazy" decoding="async" /></figure>
        </article>

        <!-- D: Lucy with a particle halo -->
        <article class="bcard bcard--d reveal">
          <div class="bcard__head">
            <h3>{cards[2].title}</h3>
            <button type="button" class="expand" data-full={cards[2].full} data-alt={cards[2].fullAlt} aria-label="Open the full screen"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-7 7M10 20H4v-6M4 20l7-7" /></svg></button>
          </div>
          <p class="bcard__line">{cards[2].line} <span class="bcard__plan">{cards[2].plan}</span></p>
          <canvas class="halo" width="320" height="320" aria-hidden="true"></canvas>
          <div class="chat">
            <p class="chat__q">What is the total of this quote and when was it sent?</p>
            <p class="chat__a">EST-0008 is $1,107.17 and it hasn't been sent — it's still a draft, created this morning at 8:25. The only quote sent to Mia is EST-0001 ($2,640.00), emailed yesterday 22 October.</p>
            <p class="chat__src small">Sources: Estimates · Client status</p>
          </div>
          <p class="bcard__fine small">Her words from the demo screen, not invented. Your data only; every call in your audit log.</p>
        </article>

        <!-- E: timesheets -->
        <article class="bcard bcard--e reveal">
          <div class="bcard__head">
            <h3>{cards[3].title}</h3>
            <button type="button" class="expand" data-full={cards[3].full} data-alt={cards[3].fullAlt} aria-label="Open the full screen"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-7 7M10 20H4v-6M4 20l7-7" /></svg></button>
          </div>
          <p class="bcard__line">{cards[3].line} <span class="bcard__plan">{cards[3].plan}</span></p>
          <div class="bcard__wash bcard__wash--e" aria-hidden="true"></div>
          <figure class="mock mock--browser bcard__crop"><img src={`${W}/17-timesheets-week-1440.webp`} alt="Timesheets: a pay-week grid with regular and overtime hours" width="1200" height="750" loading="lazy" decoding="async" /></figure>
        </article>

        <!-- F: live jobs, wide -->
        <article class="bcard bcard--f reveal">
          <div class="bcard__text">
            <div class="bcard__head">
              <h3>{cards[4].title}</h3>
            </div>
            <p class="bcard__line">{cards[4].line}</p>
            <ul class="checklist small">
              <li>Labour cost straight from the time clock</li>
              <li>Variations the client approves on a link</li>
              <li>Daily reports with photos (Enterprise)</li>
            </ul>
            <a class="bcard__more" href={cards[4].href}>More about live jobs <span aria-hidden="true">→</span></a>
          </div>
          <div class="bcard__media">
            <button type="button" class="expand" data-full={cards[4].full} data-alt={cards[4].fullAlt} aria-label="Open the full screen"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-7 7M10 20H4v-6M4 20l7-7" /></svg></button>
            <div class="bcard__wash bcard__wash--f" aria-hidden="true"></div>
            <figure class="mock mock--browser bcard__crop bcard__crop--f"><img src={`${W}/16-job-drawer-1440.webp`} alt="A live job: the site on a map, the client, the crew and the project drawer" width="1200" height="750" loading="lazy" decoding="async" /></figure>
          </div>
        </article>
      </div>

      <p class="also reveal"><span>And also:</span> {more.map((m) => <a href={`/features#${m.id}`}>{m.name.replace(/:.*$/, '')}</a>)}</p>
    </div>
  </section>

  <!-- Watch it work -->
  <section class="section section--sunken watch" id="watch">
    <div class="container">
      <h2 class="bento__h reveal"><span class="nh__dark">Watch it work.</span> <span class="nh__light">Four short walkthroughs, no sound.</span></h2>
      <div class="watch__in">
        <ol class="chapters" id="chapters">
          {chapters.map((c, i) => (
            <li><button type="button" class={`chapter ${i === 0 ? 'is-on' : ''}`} data-i={i} aria-pressed={i === 0 ? 'true' : 'false'}><span class="chapter__n mono">{String(i + 1).padStart(2, '0')}</span><span class="chapter__t">{c.title}</span><span class="chapter__d mono">{Math.floor(c.seconds / 60)}:{String(c.seconds % 60).padStart(2, '0')}</span></button></li>
          ))}
        </ol>
        <div class="player" id="player">
          {chapters.map((c, i) => (
            <div class="player__slot" data-i={i} hidden={i !== 0}><Clip id={c.id} /></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Feedback (samples until real ones exist) -->
  {quotes.length > 0 && (
    <section class="section fb" id="feedback">
      <div class="container">
        <h2 class="bento__h reveal"><span class="nh__dark">What painters say.</span> {quotes.some((t) => t.sample) && <span class="nh__light">Sample quotes for now; real ones replace them as they come in.</span>}</h2>
        <div class="fb__row">
          {quotes.map((t) => (
            <figure class="fb__card reveal">
              {t.sample && <span class="pill pill--neutral">Sample</span>}
              <blockquote><p>{t.quote}</p></blockquote>
              <figcaption class="small"><strong>{t.who}</strong> · {t.where}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ, four only -->
  <section class="section section--sunken">
    <div class="container faq-wrap">
      <h2 class="bento__h reveal"><span class="nh__dark">Questions painters ask.</span></h2>
      <Faq items={homeFaqs} openFirst />
      <p class="small"><a href="/pricing#faq">More answers on the pricing page</a></p>
    </div>
  </section>

  <!-- Closing on a soft ribbon -->
  <section class="nend">
    <div class="ribbon ribbon--end" aria-hidden="true"><i class="ribbon__a"></i><i class="ribbon__b"></i><i class="ribbon__d"></i></div>
    <div class="container nend__in">
      <h2 class="bento__h"><span class="nh__dark">Try it on your own jobs.</span> <span class="nh__light">30 days free on every plan. No card. Your login arrives by email.</span></h2>
      <Button href={site.status.ctaHref} size="lg">{site.status.cta} <span aria-hidden="true">›</span></Button>
    </div>
  </section>

  <!-- Full-screen viewer for the expand buttons -->
  <dialog class="viewer" id="viewer">
    <button type="button" class="viewer__close" id="viewer-close" aria-label="Close">×</button>
    <img id="viewer-img" src="" alt="" />
    <p class="small viewer__cap" id="viewer-cap"></p>
  </dialog>

  <!-- Sticky phone bar -->
  <div class="sticky" id="sticky" hidden>
    <span class="small">30 days free · no card</span>
    <Button href={site.status.ctaHref} size="sm">{site.status.cta}</Button>
  </div>
</Base>

<style>
  /* ---------- hero ---------- */
  .nh { position: relative; overflow: hidden; padding: clamp(56px, 9vw, 128px) 0 clamp(56px, 8vw, 112px); background: var(--bg); }
  .nh__in { position: relative; max-width: 740px; }
  .nh__kicker { font-size: 14px; font-weight: 600; color: var(--text-2); margin: 0 0 18px; letter-spacing: 0.01em; }
  .nh__h1 { font-size: clamp(34px, 5.2vw, 64px); line-height: 1.08; letter-spacing: -0.015em; margin: 0 0 32px; font-weight: 600; }
  .nh__dark { color: var(--text); }
  .nh__light { color: #5c4c9e; font-weight: 500; }
  .nh__cta { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }
  .nh__ghostbtn { background: rgba(255, 255, 255, 0.75); }
  .nh__fine { margin-top: 18px; font-size: 14px; color: var(--text-2); }

  /* the ribbon: bold, purple only, several shades folded into one band plus three thinner ones */
  .ribbon { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .ribbon i { position: absolute; display: block; filter: blur(1.2px) saturate(1.15); will-change: transform; }
  .ribbon__a { left: 56%; top: -40%; width: 40vw; min-width: 360px; height: 190%; border-radius: 48% 52% 40% 60% / 20% 18% 82% 80%; background: linear-gradient(100deg, #2a2150 0%, #34295e 12%, #4b3e86 28%, #6b5bb5 44%, #9a8cd8 58%, #cfc3f3 68%, #8a5fb8 80%, #5c4c9e 92%, #2f2560 100%); transform: rotate(27deg); animation: driftA 22s ease-in-out infinite alternate; box-shadow: inset -60px 0 90px rgba(255, 255, 255, 0.18), inset 60px 0 90px rgba(42, 33, 80, 0.35); }
  .ribbon__b { left: 73%; top: -30%; width: 14vw; min-width: 130px; height: 170%; border-radius: 50% 50% 50% 50% / 15% 15% 85% 85%; background: linear-gradient(180deg, #e6dffa 0%, #b7a8ea 35%, #7a63c9 70%, #34295e 100%); transform: rotate(24deg); animation: driftB 26s ease-in-out infinite alternate; }
  .ribbon__c { left: 49%; top: -20%; width: 8vw; min-width: 80px; height: 160%; border-radius: 50% / 10% 10% 90% 90%; background: linear-gradient(180deg, #cfc3f3 0%, #8a79d6 45%, #4b3e86 75%, #1f183d 100%); transform: rotate(31deg); opacity: 0.95; animation: driftC 30s ease-in-out infinite alternate; }
  .ribbon__d { left: 67%; top: -30%; width: 2.2vw; min-width: 18px; height: 180%; border-radius: 50% / 8% 8% 92% 92%; background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, #efe9ff 30%, #ffffff 50%, #efe9ff 70%, rgba(255, 255, 255, 0) 100%); transform: rotate(27deg); opacity: 0.75; mix-blend-mode: soft-light; animation: driftA 22s ease-in-out infinite alternate; }
  @keyframes driftA { to { transform: rotate(25deg) translate(-2%, 3%); } }
  @keyframes driftB { to { transform: rotate(27deg) translate(3%, -2%); } }
  @keyframes driftC { to { transform: rotate(34deg) translate(2%, 4%); } }
  .nh::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, var(--bg) 0%, var(--bg) 36%, rgba(250, 249, 246, 0) 58%); pointer-events: none; }
  .nh__in { z-index: 1; }

  /* ---------- facts ---------- */
  .facts { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: var(--surface); }
  .facts__in { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px 24px; padding: 18px 0; font-size: 15px; color: var(--text-2); }
  .facts__in strong { color: var(--text); }

  /* ---------- bento ---------- */
  .bento__h { font-size: clamp(26px, 3.4vw, 40px); line-height: 1.15; letter-spacing: -0.01em; max-width: 24ch; margin: 0 0 28px; font-weight: 600; }
  .bento__h .nh__light { display: block; font-size: 0.72em; margin-top: 6px; }
  .grid12 { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; }
  .bcard { position: relative; overflow: hidden; background: var(--surface); border: 1px solid var(--border); border-radius: 18px; padding: 24px; box-shadow: var(--shadow-card); display: flex; flex-direction: column; gap: 10px; min-height: 300px; }
  .bcard__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .bcard h3 { margin: 0; font-size: clamp(20px, 1.8vw, 26px); line-height: 1.2; max-width: 22ch; }
  .bcard__line { margin: 0; color: var(--text-2); max-width: 36ch; }
  .bcard__plan { display: inline-block; font-size: 11px; font-weight: 600; color: var(--accent-ink); background: var(--accent-bg); border-radius: var(--r-pill); padding: 2px 8px; vertical-align: middle; margin-left: 6px; }
  .bcard__more { margin-top: auto; font-weight: 600; color: var(--accent-ink); position: relative; z-index: 1; }
  .bcard__fine { color: var(--muted); margin: auto 0 0; position: relative; z-index: 1; }
  .expand { flex: none; width: 34px; height: 34px; border-radius: 10px; border: 0; background: var(--accent); color: #fff; display: grid; place-items: center; cursor: pointer; transition: background-color 140ms ease, transform 140ms ease; position: relative; z-index: 2; }
  .expand:hover { background: var(--accent-hover); transform: translateY(-1px); }
  .bcard__wash { position: absolute; border-radius: 50%; filter: blur(28px); pointer-events: none; z-index: 0; }
  .bcard__wash--a { right: -8%; bottom: -30%; width: 55%; height: 80%; background: radial-gradient(closest-side, rgba(246, 201, 162, 0.9), rgba(233, 165, 200, 0.55) 55%, transparent); }
  .bcard__wash--b { left: -20%; bottom: -20%; width: 120%; height: 60%; background: radial-gradient(closest-side, rgba(138, 121, 214, 0.55), rgba(233, 165, 200, 0.35) 60%, transparent); }
  .bcard__wash--c { right: -30%; top: 30%; width: 100%; height: 90%; background: radial-gradient(closest-side, rgba(246, 201, 162, 0.85), rgba(240, 180, 142, 0.35) 60%, transparent); }
  .bcard__wash--e { left: -10%; bottom: -40%; width: 90%; height: 90%; background: radial-gradient(closest-side, rgba(154, 140, 216, 0.5), transparent 70%); }
  .bcard__wash--f { right: -10%; top: -20%; width: 70%; height: 120%; background: radial-gradient(closest-side, rgba(233, 165, 200, 0.55), rgba(246, 201, 162, 0.45) 50%, transparent); }

  .mock { position: relative; z-index: 1; margin: 0; background: #fff; border: 1px solid rgba(30, 28, 26, 0.08); border-radius: 12px; overflow: hidden; box-shadow: 0 24px 48px -18px rgba(52, 41, 94, 0.35), 0 8px 20px -10px rgba(0, 0, 0, 0.18); }
  .mock img { display: block; width: 100%; height: auto; }
  .mock--browser .mock__dots { display: flex; gap: 5px; padding: 8px 10px; background: var(--sunken); border-bottom: 1px solid var(--border); }
  .mock__dots i { width: 8px; height: 8px; border-radius: 50%; background: var(--border-strong); }
  .mock--phone { border-radius: 22px; border: 5px solid #1e1c1a; background: #1e1c1a; aspect-ratio: 9 / 19.5; }
  .mock--phone img { height: 100%; object-fit: cover; object-position: top; }
  .bcard__crop { aspect-ratio: 16 / 9; }
  .bcard__crop img { height: 100%; object-fit: cover; object-position: 0 0; transform: scale(1.35); transform-origin: 18% 30%; }
  .bcard__crop--f img { transform-origin: 0% 18%; transform: scale(1.12); }

  /* card A: the stage */
  .bcard--a { grid-column: span 8; }
  .stage__tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 4px; position: relative; z-index: 1; }
  .stage__tab { font: inherit; background: none; border: 0; padding: 0; cursor: pointer; text-align: left; color: var(--text-2); display: grid; gap: 7px; }
  .stage__tab[aria-selected='true'] { color: var(--accent-ink); }
  .stage__bar { display: block; height: 3px; border-radius: 3px; background: rgba(75, 62, 134, 0.16); overflow: hidden; }
  .stage__fill { display: block; height: 100%; width: 0; background: var(--accent); }
  .stage__label { font-size: 13px; font-weight: 600; letter-spacing: 0.02em; }
  .stage__frames { position: relative; margin-top: 6px; padding: 0 12% 6% 0; }
  .stage__panel { position: relative; }
  .stage__panel:not([hidden]) { animation: fadein 400ms ease both; }
  @keyframes fadein { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .stage__phone { position: absolute; right: -2%; bottom: -8%; width: 24%; }
  .stage__caption { margin: 4px 0 0; color: var(--text-2); min-height: 1.4em; position: relative; z-index: 1; }
  .stage__pause { position: absolute; left: 24px; bottom: 22px; font: inherit; font-size: 12px; font-weight: 600; color: var(--accent-ink); background: rgba(255, 255, 255, 0.8); border: 1px solid rgba(75, 62, 134, 0.18); border-radius: var(--r-pill); padding: 3px 10px; cursor: pointer; z-index: 2; }
  .stage__pause[aria-pressed='true']::after { content: 'd'; }
  #stage .stage__caption { padding-left: 84px; }

  /* card B: crew, tall */
  .bcard--b { grid-column: span 4; grid-row: span 2; }
  .bcard__phone { width: min(62%, 240px); margin: 18px auto 0; }
  .bcard__phone--low { width: min(58%, 220px); margin-top: 8px; }
  /* card C, D, E */
  .bcard--c { grid-column: span 4; }
  .bcard--d { grid-column: span 4; }
  .bcard--e { grid-column: span 4; }
  /* card F wide */
  .bcard--f { grid-column: span 12; flex-direction: row; gap: 28px; align-items: center; }
  .bcard__text { flex: 0 0 38%; display: flex; flex-direction: column; gap: 10px; }
  .bcard__media { position: relative; flex: 1 1 auto; min-width: 0; }
  .bcard__media .expand { position: absolute; top: 0; right: 0; }
  .bcard__media .mock { margin-top: 44px; }

  /* Lucy card: particle halo and a chat */
  .halo { position: absolute; right: -40px; top: -20px; width: 260px; height: 260px; opacity: 0.9; pointer-events: none; z-index: 0; }
  .chat { position: relative; z-index: 1; display: grid; gap: 8px; margin-top: 8px; }
  .chat p { margin: 0; padding: 10px 12px; border-radius: 12px; font-size: 14px; line-height: 1.45; max-width: 92%; }
  .chat__q { background: var(--accent-bg); color: var(--accent-ink); justify-self: end; border-bottom-right-radius: 4px; }
  .chat__a { background: var(--sunken); color: var(--text); border-bottom-left-radius: 4px; }
  .chat__src { background: none !important; padding: 0 2px !important; color: var(--muted); }

  .also { margin: 22px 0 0; display: flex; flex-wrap: wrap; gap: 8px 10px; align-items: center; color: var(--text-2); font-size: 14px; }
  .also a { font-weight: 600; color: var(--accent-ink); background: var(--accent-bg); border-radius: var(--r-pill); padding: 5px 11px; }
  .also a:hover { background: var(--accent); color: #fff; text-decoration: none; }

  /* ---------- watch ---------- */
  .watch__in { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(20px, 4vw, 40px); align-items: start; }
  .chapters { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .chapter { width: 100%; display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: center; text-align: left; font: inherit; padding: 14px 16px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md); cursor: pointer; color: var(--text); }
  .chapter:hover { border-color: rgba(75, 62, 134, 0.35); }
  .chapter.is-on { border-color: var(--accent); background: var(--accent-bg); }
  .chapter__n { font-size: 12px; color: var(--muted); }
  .chapter__t { font-weight: 600; }
  .chapter__d { font-size: 12px; color: var(--text-2); }
  .player__slot[hidden] { display: none; }

  /* ---------- feedback / faq ---------- */
  .fb__row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .fb__card { margin: 0; display: grid; gap: 12px; padding: 22px; background: var(--surface); border: 1px solid var(--border); border-radius: 18px; }
  .fb__card .pill { justify-self: start; }
  .fb__card blockquote { margin: 0; font-family: var(--font-display); font-size: 19px; line-height: 1.4; }
  .fb__card blockquote p { margin: 0; }
  .faq-wrap { max-width: 820px; }

  /* ---------- closing ---------- */
  .nend { position: relative; overflow: hidden; padding: clamp(64px, 9vw, 120px) 0; background: var(--bg); }
  .ribbon--end { opacity: 0.85; }
  .ribbon--end .ribbon__a { left: -12%; top: -50%; transform: rotate(-27deg); }
  .ribbon--end .ribbon__b { left: 14%; transform: rotate(-24deg); }
  .ribbon--end .ribbon__c { display: none; }
  .ribbon--end .ribbon__d { left: 4%; transform: rotate(-27deg); }
  .nend::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(250, 249, 246, 0) 30%, var(--bg) 62%); pointer-events: none; }
  .nend__in { position: relative; z-index: 1; max-width: 760px; margin-left: auto; text-align: left; }
  .nend .bento__h { margin-bottom: 24px; }

  /* ---------- viewer ---------- */
  .viewer { border: 0; border-radius: 16px; padding: 12px; max-width: min(1200px, 94vw); background: var(--surface); box-shadow: var(--shadow-float); }
  .viewer::backdrop { background: rgba(30, 28, 26, 0.6); backdrop-filter: blur(4px); }
  .viewer img { display: block; max-width: 100%; max-height: 80vh; margin: 0 auto; border-radius: 10px; }
  .viewer__cap { margin: 10px 4px 0; color: var(--text-2); }
  .viewer__close { position: absolute; top: 8px; right: 8px; width: 36px; height: 36px; border-radius: 50%; border: 0; background: var(--accent); color: #fff; font-size: 22px; line-height: 1; cursor: pointer; }

  /* ---------- sticky bar ---------- */
  .sticky { display: none; }
  :global(body[data-sticky] .chat) { bottom: 76px; }

  /* ---------- reveal ---------- */
  html.js .reveal { opacity: 0; transform: translateY(14px); transition: opacity 500ms ease, transform 500ms ease; }
  html.js .reveal.is-in { opacity: 1; transform: none; }

  @media (max-width: 1024px) {
    .bcard--a { grid-column: span 12; }
    .bcard--b { grid-column: span 6; grid-row: auto; }
    .bcard--c, .bcard--d, .bcard--e { grid-column: span 6; }
  }
  @media (max-width: 860px) {
    .ribbon__a { left: 38%; width: 64vw; }
    .ribbon__b { left: 80%; }
    .ribbon__c { left: 28%; }
    .ribbon__d { left: 56%; }
    .nh::after { background: linear-gradient(180deg, rgba(250, 249, 246, 0.2), var(--bg) 85%); }
    .bcard--f { flex-direction: column; align-items: stretch; }
    .bcard__text { flex-basis: auto; }
    .watch__in { grid-template-columns: minmax(0, 1fr); }
    .chapters { grid-template-columns: 1fr 1fr; }
    .fb__row { grid-template-columns: minmax(0, 1fr); }
    .nend__in { text-align: left; margin-left: 0; }
    .sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px max(16px, env(safe-area-inset-left, 0px)) calc(10px + env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-right, 0px)); background: rgba(255, 255, 255, 0.92); border-top: 1px solid var(--border); backdrop-filter: blur(8px); }
    .sticky[hidden] { display: none; }
  }
  @media (max-width: 600px) {
    .bcard--b, .bcard--c, .bcard--d, .bcard--e { grid-column: span 12; }
    .bcard { min-height: 0; }
    .stage__frames { padding-right: 18%; }
    .stage__phone { width: 30%; }
    .chapters { grid-template-columns: 1fr; }
    .facts__in { justify-content: flex-start; gap: 6px 18px; font-size: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ribbon i { animation: none; }
    .stage__panel:not([hidden]) { animation: none; }
    html.js .reveal { opacity: 1; transform: none; transition: none; }
    .expand { transition: none; }
  }
</style>

<script>
  document.documentElement.classList.add('js');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- the four-step stage inside the first card
  (() => {
    const stage = document.getElementById('stage');
    if (!stage) return;
    const tabs = Array.from(stage.querySelectorAll<HTMLButtonElement>('.stage__tab'));
    const panels = Array.from(stage.querySelectorAll<HTMLElement>('.stage__panel'));
    const caption = document.getElementById('stage-caption');
    const pauseBtn = document.getElementById('stage-pause') as HTMLButtonElement | null;
    const captions = ['Built from your Library, room by room.', 'Signed on their phone. No account, no app.', 'The accepted quote becomes the live job; crew sign in with GPS.', 'Invoices follow the payment schedule on the quote.'];
    const MS = 4000;
    let i = 0, timer = 0, paused = reduced, userPaused = false, visible = true, hovered = false;
    const show = (n: number) => {
      i = (n + tabs.length) % tabs.length;
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i));
        const f = t.querySelector<HTMLElement>('.stage__fill');
        if (!f) return;
        f.style.transition = 'none'; f.style.width = k < i ? '100%' : '0'; void f.offsetWidth;
        if (k === i && !paused) { f.style.transition = `width ${MS}ms linear`; f.style.width = '100%'; }
        if (k === i && paused) f.style.width = '100%';
      });
      panels.forEach((p, k) => { p.hidden = k !== i; });
      if (caption) caption.textContent = captions[i];
    };
    const schedule = () => { clearTimeout(timer); if (!paused) timer = window.setTimeout(() => { show(i + 1); schedule(); }, MS); };
    const recompute = () => { const was = paused; paused = reduced || userPaused || hovered || !visible || document.hidden; stage.toggleAttribute('data-paused', paused); if (paused) clearTimeout(timer); else if (was) { show(i); schedule(); } };
    tabs.forEach((t) => t.addEventListener('click', () => { userPaused = true; pauseBtn?.setAttribute('aria-pressed', 'true'); recompute(); show(Number(t.dataset.i)); }));
    stage.addEventListener('mouseenter', () => { hovered = true; recompute(); });
    stage.addEventListener('mouseleave', () => { hovered = false; recompute(); });
    stage.addEventListener('focusin', () => { hovered = true; recompute(); });
    stage.addEventListener('focusout', () => { hovered = false; recompute(); });
    stage.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') { userPaused = true; show(i + 1); } if (e.key === 'ArrowLeft') { userPaused = true; show(i - 1); } });
    pauseBtn?.addEventListener('click', () => { userPaused = !userPaused; pauseBtn.setAttribute('aria-pressed', String(userPaused)); recompute(); });
    document.addEventListener('visibilitychange', recompute);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; recompute(); }, { threshold: 0.3 }).observe(stage);
    window.setTimeout(() => { recompute(); if (!paused) { show(0); schedule(); } }, 900);
  })();

  // ---- Lucy's particle halo: an arc of soft dots that twinkle slowly
  (() => {
    const c = document.querySelector<HTMLCanvasElement>('.halo');
    const ctx = c?.getContext('2d');
    if (!c || !ctx) return;
    const N = 260, dots: { a: number; r: number; s: number; p: number }[] = [];
    for (let k = 0; k < N; k++) dots.push({ a: Math.PI * 0.9 + Math.random() * Math.PI * 1.1, r: 90 + Math.random() * 60 + (Math.random() < 0.2 ? Math.random() * 30 : 0), s: 0.6 + Math.random() * 1.3, p: Math.random() * Math.PI * 2 });
    let t = 0, raf = 0, on = true;
    const draw = () => {
      ctx.clearRect(0, 0, c.width, c.height);
      for (const d of dots) {
        const x = 160 + Math.cos(d.a) * d.r, y = 160 + Math.sin(d.a) * d.r;
        const al = 0.25 + 0.55 * (0.5 + 0.5 * Math.sin(t * 0.9 + d.p));
        ctx.fillStyle = d.r > 125 ? `rgba(233,165,200,${al})` : `rgba(75,62,134,${al})`;
        ctx.beginPath(); ctx.arc(x, y, d.s, 0, Math.PI * 2); ctx.fill();
      }
    };
    const loop = () => { if (!on) return; t += 0.03; draw(); raf = requestAnimationFrame(loop); };
    draw();
    if (reduced) return;
    new IntersectionObserver(([e]) => { on = e.isIntersecting && !document.hidden; cancelAnimationFrame(raf); if (on) loop(); }).observe(c);
    document.addEventListener('visibilitychange', () => { on = !document.hidden; cancelAnimationFrame(raf); if (on) loop(); });
  })();

  // ---- expand buttons open the full screen in a dialog
  (() => {
    const dlg = document.getElementById('viewer') as HTMLDialogElement | null;
    const img = document.getElementById('viewer-img') as HTMLImageElement | null;
    const cap = document.getElementById('viewer-cap');
    if (!dlg || !img || !cap) return;
    document.querySelectorAll<HTMLButtonElement>('.expand').forEach((b) => b.addEventListener('click', () => {
      img.src = b.dataset.full || ''; img.alt = b.dataset.alt || ''; cap.textContent = b.dataset.alt || '';
      dlg.showModal();
    }));
    document.getElementById('viewer-close')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  })();

  // ---- scroll reveals
  (() => {
    const els = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
    if (reduced || !('IntersectionObserver' in window)) { els.forEach((e) => e.classList.add('is-in')); return; }
    const io = new IntersectionObserver((entries) => { entries.forEach((e) => { if (e.isIntersecting) { (e.target as HTMLElement).classList.add('is-in'); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -4% 0px' });
    els.forEach((e) => io.observe(e));
  })();

  // ---- one player, four chapters
  (() => {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('#chapters .chapter'));
    const slots = Array.from(document.querySelectorAll<HTMLElement>('#player .player__slot'));
    buttons.forEach((b) => b.addEventListener('click', () => {
      const n = Number(b.dataset.i);
      buttons.forEach((x, k) => { x.classList.toggle('is-on', k === n); x.setAttribute('aria-pressed', String(k === n)); });
      slots.forEach((s, k) => { s.hidden = k !== n; if (k !== n) s.querySelector('video')?.pause(); });
    }));
  })();

  // ---- sticky bar on phones once the hero buttons scroll away; hidden near the closing CTA
  (() => {
    const bar = document.getElementById('sticky');
    const hero = document.querySelector('.nh__cta');
    const end = document.querySelector('.nend');
    if (!bar || !hero || !end) return;
    let pastHero = false, nearEnd = false;
    const update = () => { const on = pastHero && !nearEnd; bar.hidden = !on; document.body.toggleAttribute('data-sticky', on && matchMedia('(max-width: 860px)').matches); };
    new IntersectionObserver(([e]) => { pastHero = !e.isIntersecting && e.boundingClientRect.top < 0; update(); }).observe(hero);
    new IntersectionObserver(([e]) => { nearEnd = e.isIntersecting; update(); }).observe(end);
  })();
</script>
