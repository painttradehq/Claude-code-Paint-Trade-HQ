---
/**
 * Start free trial, in the home page's language (31 Oct 2026). What this page has that the others don't: the
 * "what happens next" steps drawn as a numbered path beside the form, so the manual part (we set the account
 * up and email the login) is plain before anyone types. The form itself (InviteForm) is unchanged: same fields,
 * honeypot, optional Turnstile, the same /api/invite function and redirects.
 */
import Base from '../layouts/Base.astro';
import InviteForm from '../components/InviteForm.astro';
import Reveal from '../components/Reveal.astro';
import { site } from '../data/site';

const steps = [
  { t: 'Leave your details', w: 'Name, business, where you are, how many on the crew. No card, no password, no ABN.' },
  { t: 'We set up your account', w: 'And email your login, usually the same business day.' },
  { t: 'Use everything for 30 days', w: 'Then pick a plan, or walk away with your data.' },
];
---
<Base title="Start your free trial" description="Try every part of Paint Trade HQ free for 30 days, no card needed. Leave your details and your login arrives by email.">
  <section class="thero">
    <div class="container trial">
      <div class="trial__copy">
        <h1 class="tone tone--h1 trial__h"><span class="tone__dark">Start your free trial.</span> <span class="tone__light">30 days, every plan, no card. Your login arrives by email.</span></h1>

        <ol class="path reveal" aria-label="What happens next">
          {steps.map((s, i) => (
            <li class="path__step">
              <span class="path__n mono" aria-hidden="true">{i + 1}</span>
              <div>
                <h2 class="path__t">{s.t}</h2>
                <p class="path__w">{s.w}</p>
              </div>
            </li>
          ))}
        </ol>

        <ul class="facts reveal" aria-label="Key facts">
          <li><strong>No card</strong> to start</li>
          <li><strong>No lock-in</strong>, monthly after the trial</li>
          <li><strong>Your data</strong>, exportable any time</li>
        </ul>

        <p class="small trial__links reveal">Already have access? <a href={site.signInUrl} rel="noopener">Sign in</a>. On the crew? <a href={site.crewUrl} rel="noopener">Crew sign-in</a>. Prefer email? <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a></p>
      </div>
      <div class="trial__form reveal">
        <InviteForm />
      </div>
    </div>
  </section>

  <Reveal />
</Base>

<style>
  .thero { padding: clamp(36px, 5vw, 64px) 0 clamp(48px, 6vw, 80px); background: var(--bg); }
  .trial { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  .trial__h { font-size: clamp(30px, 3.8vw, 46px); margin-bottom: 26px; max-width: 18ch; }

  /* the path */
  .path { list-style: none; margin: 0 0 22px; padding: 0; position: relative; display: grid; gap: 14px; }
  .path::before { content: ''; position: absolute; left: 19px; top: 20px; bottom: 20px; width: 2px; background: linear-gradient(180deg, var(--accent), var(--border-strong)); }
  .path__step { position: relative; display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 14px; align-items: start; }
  .path__n { width: 40px; height: 40px; border-radius: 50%; background: var(--accent); color: #fff; display: grid; place-items: center; font-weight: 500; box-shadow: 0 0 0 5px var(--bg); position: relative; z-index: 1; }
  .path__t { margin: 8px 0 2px; font-size: 19px; line-height: 1.2; }
  .path__w { margin: 0; color: var(--text-2); font-size: 15px; line-height: 1.5; }

  .facts { list-style: none; margin: 0 0 16px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 20px; color: var(--text-2); font-size: 15px; }
  .facts strong { color: var(--text); }
  .trial__links { color: var(--text-2); line-height: 1.7; }
  .trial__form { position: sticky; top: calc(var(--header-h) + 16px); }

  @media (max-width: 860px) {
    .trial { grid-template-columns: minmax(0, 1fr); }
    .trial__form { position: static; }
  }
</style>
