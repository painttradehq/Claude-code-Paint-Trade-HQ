---
import Base from '../layouts/Base.astro';
import InviteForm from '../components/InviteForm.astro';
import { site } from '../data/site';
---
<Base title="Start your free trial" description="Try every part of Paint Trade HQ free for 30 days, no card needed. Leave your details and your login arrives by email.">
  <section class="section">
    <div class="container invite">
      <div class="invite__copy">
        <span class="eyebrow"><span class="pill">{site.status.pill}</span></span>
        <h1>Start your free trial</h1>
        <p class="lead">Every plan comes with a 30-day free trial. No card, no lock-in: use everything, then pick a plan or walk away.</p>
        <h3>What happens next</h3>
        <ol class="steps">
          <li>Leave your details below.</li>
          <li>We set up your account and email your login, usually the same business day.</li>
          <li>Use everything for 30 days. Then pick a plan, or walk away with your data.</li>
        </ol>
        <p class="small">Already have access? <a href={site.signInUrl} rel="noopener">Sign in</a>. On the crew? <a href={site.crewUrl} rel="noopener">Crew sign-in</a>.</p>
        <p class="small">Prefer email? <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a></p>
      </div>
      <div>
        <InviteForm />
      </div>
    </div>
  </section>
</Base>

<style>
  .invite {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  .invite__copy h3 { margin-top: 24px; }
  .steps { padding-left: 22px; color: var(--text-2); display: grid; gap: 8px; }
  @media (max-width: 860px) {
    .invite { grid-template-columns: minmax(0, 1fr); }
  }
</style>
