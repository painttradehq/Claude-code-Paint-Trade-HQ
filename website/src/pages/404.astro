---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { site, chatEnabled } from '../data/site';
---
<Base title="Page not found" noindex>
  <section class="section">
    <div class="container center nf">
      <span class="eyebrow">404</span>
      <h1>That page isn't here</h1>
      <p class="lead">Try the home page{chatEnabled ? ', or ask the chat box in the corner' : ''}.</p>
      <div class="row" style="justify-content:center">
        <Button href="/">Home</Button>
        <Button href={site.status.ctaHref} variant="ghost">{site.status.cta}</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { max-width: 640px; }
  .nf .lead { margin-left: auto; margin-right: auto; }
</style>
