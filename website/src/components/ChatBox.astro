---
/**
 * The website chat box. It answers only from docs/website/chat-knowledge.md, which the serverless
 * function (functions/api/chat.js) holds as its system prompt. When the assistant cannot answer, it
 * asks for an email and this panel shows a small lead form that posts to /api/invite with source "chat".
 */
import { site } from '../data/site';
---
<div class="chat" id="chat" data-state="closed">
  <button class="chat__fab btn btn--primary" type="button" id="chat-open" aria-haspopup="dialog" aria-expanded="false" aria-controls="chat-panel">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H9l-4.2 3.4A.5.5 0 0 1 4 19V5.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
    <span>Ask about Paint Trade HQ</span>
  </button>

  <section class="chat__panel" id="chat-panel" role="dialog" aria-label="Ask about Paint Trade HQ" aria-modal="false" hidden>
    <header class="chat__head">
      <img src="/brand/logo.svg" alt="" width="28" height="28" />
      <div class="chat__title">
        <strong>Ask about Paint Trade HQ</strong>
        <span class="small">Answers from how the app works today. Not legal or tax advice.</span>
      </div>
      <button class="chat__close" type="button" id="chat-close" aria-label="Close chat">×</button>
    </header>

    <div class="chat__log" id="chat-log" aria-live="polite" aria-relevant="additions">
      <div class="chat__msg chat__msg--bot">
        <p>G'day. Ask me how Paint Trade HQ handles quotes, jobs, crew sign-in, invoices or pricing. If I don't know, I'll take your email and we'll answer.</p>
      </div>
      <div class="chat__starters" id="chat-starters">
        <button type="button" class="chat__starter">How does the client sign a quote?</button>
        <button type="button" class="chat__starter">What does it cost?</button>
        <button type="button" class="chat__starter">Does it track my crew?</button>
        <button type="button" class="chat__starter">How does the free trial work?</button>
      </div>
    </div>

    <form class="chat__lead" id="chat-lead" hidden>
      <p class="small"><strong>Leave your details</strong> and we'll get back to you. This chat goes with them for context.</p>
      <div class="chat__lead-row">
        <input class="input" name="name" type="text" placeholder="Your name" autocomplete="name" required />
        <input class="input" name="email" type="email" placeholder="Email" autocomplete="email" required />
      </div>
      <input type="text" name="website" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="row">
        <button class="btn btn--primary btn--sm" type="submit">Send</button>
        <a class="small" href={site.status.ctaHref}>Or start your free trial</a>
      </div>
    </form>

    <form class="chat__form" id="chat-form">
      <label class="visually-hidden" for="chat-input">Your question</label>
      <input class="input" id="chat-input" name="q" type="text" placeholder="Type a question…" autocomplete="off" maxlength="500" required />
      <button class="btn btn--primary" type="submit" id="chat-send">Send</button>
    </form>
    <p class="chat__foot small">Powered by Anthropic. The chat keeps no account data; don't type passwords or card numbers.</p>
  </section>
</div>

<style>
  .chat { position: fixed; right: 18px; bottom: 18px; z-index: 50; }
  .chat__fab { box-shadow: var(--shadow-float); border-radius: var(--r-pill); padding: 0 18px; }
  .chat[data-state='open'] .chat__fab { display: none; }
  .chat__panel {
    width: min(400px, calc(100vw - 24px));
    height: min(620px, calc(100vh - 36px));
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-float);
    overflow: hidden;
  }
  .chat__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    background: var(--accent-ink);
    color: #fff;
  }
  .chat__head img { border-radius: 7px; background: #fff; }
  .chat__title { display: flex; flex-direction: column; line-height: 1.25; flex: 1; }
  .chat__title .small { color: rgba(255, 255, 255, 0.78); }
  .chat__close {
    background: transparent;
    border: 0;
    color: #fff;
    font-size: 26px;
    line-height: 1;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    cursor: pointer;
  }
  .chat__close:hover { background: rgba(255, 255, 255, 0.12); }
  .chat__log {
    flex: 1;
    overflow-y: auto;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--bg);
  }
  .chat__msg {
    max-width: 88%;
    padding: 10px 12px;
    border-radius: 12px;
    font-size: 15px;
    line-height: 1.5;
  }
  .chat__msg p { margin: 0 0 8px; }
  .chat__msg p:last-child { margin: 0; }
  .chat__msg--bot { background: var(--surface); border: 1px solid var(--border); align-self: flex-start; border-bottom-left-radius: 4px; }
  .chat__msg--me { background: var(--accent); color: #fff; align-self: flex-end; border-bottom-right-radius: 4px; }
  .chat__msg--err { background: var(--danger-bg); color: var(--danger); align-self: flex-start; }
  .chat__msg--typing { color: var(--muted); font-style: italic; }
  .chat__starters { display: flex; flex-wrap: wrap; gap: 8px; }
  .chat__starter {
    background: var(--accent-bg);
    color: var(--accent-ink);
    border: 1px solid transparent;
    border-radius: var(--r-pill);
    padding: 7px 12px;
    font: inherit;
    font-size: 13.5px;
    font-weight: 500;
    cursor: pointer;
  }
  .chat__starter:hover { border-color: var(--accent); }
  .chat__lead { padding: 12px 14px; border-top: 1px solid var(--border); background: var(--accent-bg); }
  .chat__lead p { margin: 0 0 8px; }
  .chat__lead-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px; }
  .chat__form { display: flex; gap: 8px; padding: 12px 14px; border-top: 1px solid var(--border); }
  .chat__form .input { flex: 1; min-height: 44px; }
  .chat__foot { margin: 0; padding: 0 14px 10px; color: var(--muted); font-size: 12px; }
  @media (max-width: 480px) {
    .chat { right: 10px; bottom: 10px; }
    .chat__fab span { font-size: 15px; }
    .chat__lead-row { grid-template-columns: 1fr; }
  }
</style>

<script>
  type Msg = { role: 'user' | 'assistant'; content: string };
  const root = document.getElementById('chat')!;
  const openBtn = document.getElementById('chat-open') as HTMLButtonElement;
  const closeBtn = document.getElementById('chat-close') as HTMLButtonElement;
  const panel = document.getElementById('chat-panel') as HTMLElement;
  const log = document.getElementById('chat-log') as HTMLElement;
  const form = document.getElementById('chat-form') as HTMLFormElement;
  const input = document.getElementById('chat-input') as HTMLInputElement;
  const send = document.getElementById('chat-send') as HTMLButtonElement;
  const lead = document.getElementById('chat-lead') as HTMLFormElement;
  const starters = document.getElementById('chat-starters') as HTMLElement;

  const history: Msg[] = [];
  const MAX_TURNS = 12;
  let busy = false;

  function setOpen(open: boolean) {
    root.dataset.state = open ? 'open' : 'closed';
    panel.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    if (open) input.focus();
    else openBtn.focus();
  }
  openBtn.addEventListener('click', () => setOpen(true));
  closeBtn.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) setOpen(false); });

  function bubble(role: 'bot' | 'me' | 'err' | 'typing', text = '') {
    const el = document.createElement('div');
    el.className = `chat__msg chat__msg--${role === 'typing' ? 'bot chat__msg--typing' : role}`;
    setText(el, text);
    log.appendChild(el);
    log.scrollTop = log.scrollHeight;
    return el;
  }
  function setText(el: HTMLElement, text: string) {
    el.replaceChildren();
    for (const para of text.split(/\n{2,}/)) {
      const p = document.createElement('p');
      const lines = para.split('\n');
      lines.forEach((ln, i) => { p.appendChild(document.createTextNode(ln)); if (i < lines.length - 1) p.appendChild(document.createElement('br')); });
      el.appendChild(p);
    }
  }

  const LEAD_HINT = /(leave your (email|details)|what's your email|your email and (josh|we)|josh will answer|we'll answer|josh will be in touch|we'll be in touch|we will be in touch|pass this (to josh|on))/i;
  const FALLBACK = 'The chat is having a moment. Email software@joshsano.com.au or use the free trial form and we\'ll answer.';

  async function ask(q: string) {
    if (busy) return;
    const question = q.trim();
    if (!question) return;
    if (history.filter((m) => m.role === 'user').length >= MAX_TURNS) {
      bubble('bot', "That's a lot of questions for one chat, which is a good sign. Leave your email and we'll pick it up from here.");
      lead.hidden = false;
      return;
    }
    busy = true; send.disabled = true; starters.hidden = true;
    bubble('me', question);
    history.push({ role: 'user', content: question });
    input.value = '';
    const out = bubble('typing', 'Thinking…');
    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ messages: history.slice(-10), page: location.pathname }),
      });
      if (!res.ok || !res.body) {
        // The function answers 4xx/5xx with a short plain-text line meant for the visitor.
        const ct = res.headers.get('content-type') || '';
        const msg = ct.startsWith('text/plain') ? (await res.text().catch(() => '')).trim() : '';
        throw new Error(msg || `HTTP ${res.status}`);
      }
      out.classList.remove('chat__msg--typing');
      const reader = res.body.getReader();
      const dec = new TextDecoder();
      let text = '';
      for (;;) {
        const { value, done } = await reader.read();
        if (done) break;
        text += dec.decode(value, { stream: true });
        setText(out, text);
        log.scrollTop = log.scrollHeight;
      }
      text += dec.decode();
      setText(out, text);
      if (!text.trim()) throw new Error('empty');
      history.push({ role: 'assistant', content: text.slice(0, 2000) }); // the function keeps the same cap
      if (LEAD_HINT.test(text)) lead.hidden = false;
    } catch (e) {
      out.remove();
      history.pop(); // keep the history valid: no visitor turn without an answer
      const msg = e instanceof Error && e.message && !/^(HTTP \d+|empty)$/.test(e.message) ? e.message : FALLBACK;
      bubble('err', msg);
      lead.hidden = false;
    } finally {
      busy = false; send.disabled = false; input.focus();
    }
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); ask(input.value); });
  starters.querySelectorAll<HTMLButtonElement>('.chat__starter').forEach((b) => b.addEventListener('click', () => ask(b.textContent || '')));

  lead.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(lead);
    const payload = Object.fromEntries(fd.entries());
    const transcript = history.map((m) => `${m.role === 'user' ? 'Visitor' : 'Chat'}: ${m.content}`).join('\n');
    try {
      const res = await fetch('/api/invite', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ ...payload, source: 'chat', transcript }),
      });
      if (!res.ok) throw new Error(String(res.status));
      lead.hidden = true;
      bubble('bot', 'Thanks. We\'ll be in touch.');
    } catch {
      bubble('err', 'That didn\'t send. Email software@joshsano.com.au and we\'ll get it.');
    }
  });
</script>
