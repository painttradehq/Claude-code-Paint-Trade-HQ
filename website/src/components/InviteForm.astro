---
/**
 * "Ask for an invite" — the site's only call to action (builder's pack §2). Collects what the
 * knowledge file §10 lists and emails Josh through /api/invite. Works without JavaScript (plain
 * POST; the function redirects to /invite/sent or /invite/error) and with it (fetch + inline success).
 */
import { inviteFields, site } from '../data/site';
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---
<form class="invite card" id="invite-form" method="post" action="/api/invite" novalidate>
  <input type="hidden" name="source" value="invite-page" />
  <input type="hidden" name="redirect" value="/invite/sent" />
  <!-- Honeypot: real people never see or fill this. -->
  <div class="visually-hidden" aria-hidden="true">
    <label for="invite-website">Website</label>
    <input id="invite-website" type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div class="invite__grid">
    {inviteFields.map((f) => (
      <div class={`field ${f.name === 'software' ? 'field--wide' : ''}`}>
        <label for={`invite-${f.name}`}>{f.label}{f.required ? '' : <span class="muted"> (optional)</span>}</label>
        {f.type === 'select' ? (
          <select class="select" id={`invite-${f.name}`} name={f.name} required={f.required}>
            <option value="" disabled selected>Choose…</option>
            {f.options!.map((o) => <option value={o}>{o}</option>)}
          </select>
        ) : (
          <input
            class="input"
            id={`invite-${f.name}`}
            name={f.name}
            type={f.type}
            required={f.required}
            placeholder={'placeholder' in f ? f.placeholder : undefined}
            autocomplete={'autocomplete' in f ? f.autocomplete : undefined}
            inputmode={f.type === 'tel' ? 'tel' : undefined}
          />
        )}
      </div>
    ))}
  </div>

  {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="light"></div>}

  <div class="invite__foot">
    <button class="btn btn--primary btn--lg" type="submit" id="invite-submit">Ask for an invite</button>
    <p class="small invite__note">Josh reads these himself and will be in touch. No passwords, card numbers or ABN needed.</p>
  </div>

  <div class="invite__done card--sunken" id="invite-done" hidden role="status">
    <h3>Thanks, you're on the list.</h3>
    <p>Josh reads these himself and will be in touch. Invites go out as places open.</p>
    <p class="small">Already have access? <a href={site.signInUrl} rel="noopener">Sign in</a>.</p>
  </div>
  <p class="invite__error small" id="invite-error" hidden role="alert">
    That didn't send. Or email <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a> and Josh will get it.
  </p>
</form>

{turnstileKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<style>
  .invite { padding: 28px; }
  .invite__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 20px; }
  .field--wide { grid-column: 1 / -1; }
  .invite__foot { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-top: 8px; }
  .invite__note { margin: 0; max-width: 42ch; }
  .invite__done { margin-top: 20px; padding: 20px; border-radius: var(--r-md); }
  .invite__done h3 { margin-top: 0; }
  .invite__error { color: var(--danger); margin-top: 12px; }
  @media (max-width: 720px) {
    .invite { padding: 20px; }
    .invite__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const form = document.getElementById('invite-form') as HTMLFormElement;
  const done = document.getElementById('invite-done') as HTMLElement;
  const err = document.getElementById('invite-error') as HTMLElement;
  const submit = document.getElementById('invite-submit') as HTMLButtonElement;
  const SUPPORT = 'software@joshsano.com.au';

  form.addEventListener('submit', async (e) => {
    if (!form.checkValidity()) { form.reportValidity(); e.preventDefault(); return; }
    e.preventDefault();
    submit.disabled = true; err.hidden = true;
    const payload = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch('/api/invite', { method: 'POST', headers: { 'content-type': 'application/json', accept: 'application/json' }, body: JSON.stringify(payload) });
      if (!res.ok) {
        // 4xx carries a short line meant for the visitor (bad email, missing name, failed check).
        let msg = '';
        if (res.status < 500) msg = (await res.json().catch(() => ({})))?.error || '';
        throw new Error(msg);
      }
      form.querySelector('.invite__grid')?.setAttribute('hidden', '');
      form.querySelector('.invite__foot')?.setAttribute('hidden', '');
      done.hidden = false;
      done.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch (e) {
      const msg = e instanceof Error ? e.message : '';
      err.textContent = '';
      if (msg) {
        err.append(`${msg} `);
      }
      err.append('Or email ');
      const a = document.createElement('a');
      a.href = `mailto:${SUPPORT}`;
      a.textContent = SUPPORT;
      err.append(a, ' and Josh will get it.');
      err.hidden = false;
      submit.disabled = false;
      // Turnstile tokens are single-use: get a fresh one for the retry.
      (window as any).turnstile?.reset?.();
    }
  });
</script>
