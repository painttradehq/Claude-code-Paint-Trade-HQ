index 0000000000000000000000000000000000000000..54fbe4d0924ee771467e051d6fdb5bba0e79c9a7
--- /dev/null
+++ b/backend/services/job_money.py
@@ -0,0 +1,93 @@
+"""Job money — one snapshot the job page, the jobs list and the connector all read.
+
+Fix Round J B-029 / B-047 / B-055 (11 Nov 2026). The rules, in words:
+
+  Quoted (the budget)      revenue = the accepted quote + approved variations; budgeted cost = materials + labour + the FULL
+                            overhead (overhead % × quoted revenue). Expected profit = revenue − budgeted cost.
+  Actual to date           direct cost = labour + materials + equipment + expenses logged so far; overhead to date = overhead %
+                            × the revenue invoiced so far (overhead is a share of revenue, so it accrues with the billing, not on
+                            day one — B-047); cost to date = direct + overhead to date (overhead only once the job has started).
+                            Revenue to date = what has been invoiced (raised invoices, less credits) — never the whole quote
+                            (B-029). Profit so far = revenue to date − cost to date; margin to date = profit / revenue to date,
+                            0 while nothing is invoiced (the screens say "nothing invoiced yet").
+  Projected                profit = quoted revenue − max(budgeted cost, direct cost so far + full overhead).
+
+`actual_revenue` on the project, when set by hand, still overrides the invoiced figure. Pure: no Mongo, so it is unit-tested.
+"""
+from __future__ import annotations
+
+from typing import Any
+
+
+def _f(v: Any) -> float:
+    try:
+        return float(v or 0)
+    except (TypeError, ValueError):
+        return 0.0
+
+
+def compute_margin_snapshot(project: dict[str, Any], actuals: dict[str, Any]) -> dict[str, Any]:
+    est_rev = _f(project.get("estimated_revenue"))
+    est_materials = project.get("estimated_materials")
+    est_labour = project.get("estimated_labour")
+    if est_materials is None:
+        est_materials = _f(project.get("estimated_cost"))
+    if est_labour is None:
+        est_labour = _f(project.get("estimated_hours")) * _f(actuals.get("labor_hourly_rate"))
+    overhead_full = _f(actuals.get("overhead"))
+    est_cost = _f(est_materials) + _f(est_labour) + overhead_full
+    est_margin_pct = ((est_rev - est_cost) / est_rev * 100) if est_rev > 0 else 0
+
+    started = bool(actuals.get("started"))
+    direct_cost = _f(actuals.get("labour_cost")) + _f(actuals.get("materials_cost")) + _f(actuals.get("expenses_total")) + _f(actuals.get("equipment_cost"))
+    invoiced = _f(actuals.get("invoiced"))
+    overhead_to_date = round(invoiced * _f(actuals.get("overhead_pct")) / 100.0, 2) if started else 0.0
+    actual_cost = direct_cost + overhead_to_date
+
+    actual_rev_value = project.get("actual_revenue")
+    actual_rev = _f(actual_rev_value) if actual_rev_value is not None else invoiced
+    actual_profit = actual_rev - actual_cost
+    actual_margin_pct = (actual_profit / actual_rev * 100) if actual_rev > 0 else 0
+
+    projected_cost = max(est_cost, direct_cost + overhead_full)
+    cost_variance = actual_cost - est_cost
+    cost_variance_pct = (cost_variance / est_cost * 100) if est_cost > 0 else 0
+
+    return {
+        "estimated_revenue": round(est_rev, 2),
+        "estimated_cost": round(est_cost, 2),
+        "estimated_margin_pct": round(est_margin_pct, 2),
+        "actual_revenue": round(actual_rev, 2),          # revenue to date (invoiced), or the hand-set override
+        "revenue_to_date": round(actual_rev, 2),
+        "actual_cost": round(actual_cost, 2),            # cost to date
+        "direct_cost": round(direct_cost, 2),
+        "actual_profit": round(actual_profit, 2),        # profit so far
+        "actual_margin_pct": round(actual_margin_pct, 2),
+        "cost_variance": round(cost_variance, 2),
+        "cost_variance_pct": round(cost_variance_pct, 2),
+        # Iter 92 — the ingredients, so the UI can render a P&L breakdown
+        "labour_cost": round(_f(actuals.get("labour_cost")), 2),
+        "labour_hours": round(_f(actuals.get("labour_hours")), 2),
+        "labour_rate_estimated": bool(actuals.get("labour_rate_estimated")),
+        "materials_cost": round(_f(actuals.get("materials_cost")), 2),
+        "expenses_total": round(_f(actuals.get("expenses_total")), 2),
+        "equipment_cost": round(_f(actuals.get("equipment_cost")), 2),
+        "overhead": round(overhead_full, 2),              # the budget's full overhead
+        "overhead_to_date": round(overhead_to_date, 2),
+        "overhead_pct": actuals.get("overhead_pct") or 0,
+        "estimated_materials": round(_f(est_materials), 2),
+        "estimated_labour": round(_f(est_labour), 2),
+        "estimated_hours": _f(project.get("estimated_hours")),
+        "labor_hourly_rate": actuals.get("labor_hourly_rate") or 0,
+        "variations_approved": round(_f(actuals.get("variations_approved")), 2),
+        "projected_profit": round(est_rev - projected_cost, 2),
+        "invoiced": round(invoiced, 2),
+        "invoice_paid": round(_f(actuals.get("invoice_paid")), 2),
+        "invoice_count": actuals.get("invoice_count") or 0,
+        "raised_invoice_count": actuals.get("raised_invoice_count") or 0,
+        "invoice_outstanding": round(invoiced - _f(actuals.get("invoice_paid")), 2),
+        "billable_total": round(_f(actuals.get("billable_total")), 2),
+        "still_to_invoice": round(_f(actuals.get("still_to_invoice")), 2),
+        "retire_at": actuals.get("retire_at"),
+        "open_variations": actuals.get("open_variations") or [],
+    }
