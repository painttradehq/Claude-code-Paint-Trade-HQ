+"""Fix Round J B-029 / B-047 / B-055 — the job money snapshot: revenue to date is what is invoiced, overhead accrues with the
+billing, the projection keeps the full overhead. Pure: no Mongo."""
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from services.job_money import compute_margin_snapshot  # noqa: E402
+
+PROJECT = {"estimated_revenue": 10000.0, "estimated_materials": 1500.0, "estimated_labour": 4000.0, "estimated_hours": 50, "status": "in_progress"}
+BASE = {"labour_cost": 1200.0, "materials_cost": 600.0, "expenses_total": 100.0, "equipment_cost": 100.0, "overhead_pct": 12.0, "overhead": 1200.0,
+        "labor_hourly_rate": 80.0, "started": True, "invoiced": 0.0, "invoice_paid": 0.0, "invoice_count": 1, "raised_invoice_count": 0}
+
+
+def test_budget_keeps_the_full_overhead():
+    m = compute_margin_snapshot(PROJECT, BASE)
+    assert m["estimated_cost"] == 1500 + 4000 + 1200
+    assert m["overhead"] == 1200.0
+    assert m["estimated_margin_pct"] == 33.0
+
+
+def test_nothing_invoiced_means_no_revenue_and_no_overhead_yet():
+    m = compute_margin_snapshot(PROJECT, BASE)
+    assert m["revenue_to_date"] == 0.0 and m["actual_revenue"] == 0.0
+    assert m["overhead_to_date"] == 0.0
+    assert m["direct_cost"] == 2000.0 and m["actual_cost"] == 2000.0
+    assert m["actual_profit"] == -2000.0 and m["actual_margin_pct"] == 0
+
+
+def test_overhead_accrues_with_what_is_invoiced():
+    m = compute_margin_snapshot(PROJECT, {**BASE, "invoiced": 3000.0, "invoice_paid": 3000.0})
+    assert m["overhead_to_date"] == 360.0          # 12 % of the $3,000 billed, not 12 % of the $10,000 quote
+    assert m["actual_cost"] == 2360.0
+    assert m["revenue_to_date"] == 3000.0
+    assert m["actual_profit"] == 640.0
+    assert m["actual_margin_pct"] == 21.33
+
+
+def test_projection_uses_the_full_overhead_and_the_worse_of_budget_or_run_rate():
+    m = compute_margin_snapshot(PROJECT, {**BASE, "invoiced": 3000.0})
+    assert m["projected_profit"] == 10000 - 6700      # budget still the bigger cost
+    over = compute_margin_snapshot(PROJECT, {**BASE, "labour_cost": 6000.0, "invoiced": 3000.0})
+    assert over["projected_profit"] == round(10000 - (6000 + 600 + 100 + 100 + 1200), 2)
+
+
+def test_not_started_job_carries_no_overhead_to_date():
+    m = compute_margin_snapshot({**PROJECT, "status": "quoted"}, {**BASE, "started": False, "invoiced": 2000.0})
+    assert m["overhead_to_date"] == 0.0 and m["actual_cost"] == 2000.0
+
+
+def test_hand_set_actual_revenue_still_wins():
+    m = compute_margin_snapshot({**PROJECT, "actual_revenue": 9500.0}, {**BASE, "invoiced": 3000.0})
+    assert m["revenue_to_date"] == 9500.0 and m["actual_profit"] == round(9500 - 2360, 2)
+
+
+def test_legacy_project_without_split_estimates_still_computes():
+    m = compute_margin_snapshot({"estimated_revenue": 5000, "estimated_cost": 900, "estimated_hours": 10}, {**BASE, "overhead": 150.0, "overhead_pct": 3.0})
+    assert m["estimated_cost"] == 900 + 10 * 80 + 150
