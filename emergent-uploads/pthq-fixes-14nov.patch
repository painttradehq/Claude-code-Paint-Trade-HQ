index 0000000000000000000000000000000000000000..8c6653b2458a05640723b7735147c6411e041e6f
--- /dev/null
+++ b/backend/services/quote_guard.py
@@ -0,0 +1,112 @@
+"""Quote guard — what can still change on a quote once a job or an invoice depends on it.
+
+Fix Round J B-042 / B-044 (11 Nov 2026).
+
+  • money_signature(est) — the money the client agreed to: every line's qty × rate (auto-measured lines through their
+    area), optional flags, the discount, the tax mode, the payment plan percentages and the paint settings. Notes, photos,
+    dates, terms, labels and the client details are NOT in it, so those still save.
+  • money_change_block(admin_id, existing, proposed) — a reason when `existing` is accepted, a raised invoice (sent or
+    paid — never a draft) exists against it or its job, and `proposed` changes the money signature. Extra or changed work
+    goes on the job as a variation instead.
+  • status_change_block(admin_id, cur, new_status) — a reason when an accepted quote would move to any other status while
+    a job or a raised invoice depends on it, or when any quote would be archived while a job or a raised invoice depends
+    on it. Accepted quotes can't be archived at all (the rule since Round 40).
+
+The async helpers take an optional `db` so they can be tested without Mongo.
+"""
+from __future__ import annotations
+
+import json
+from typing import Any
+
+RAISED_EXCLUDED = ("draft", "cancelled", "credited", "archived")  # = services.crm_stats.NOT_INVOICED
+STATUS_LABEL = {"draft": "Draft", "sent": "Sent", "viewed": "Viewed", "accepted": "Accepted", "declined": "Declined", "on_hold": "On hold", "archived": "Archived"}
+
+
+def _db():
+    from database import db
+    return db
+
+
+def _num(v: Any) -> float | None:
+    try:
+        return None if v is None or v == "" else round(float(v), 4)
+    except (TypeError, ValueError):
+        return None
+
+
+def money_signature(est: dict[str, Any] | None) -> str:
+    """A string that changes only when the client's money changes (see the module docstring)."""
+    from services.estimate_lines import compute_line
+    est = est or {}
+    areas = {a.get("id"): a for a in (est.get("areas") or []) if isinstance(a, dict)}
+    lines = []
+    for ln in est.get("lines") or []:
+        if not isinstance(ln, dict):
+            continue
+        c = compute_line(ln, areas.get(ln.get("area_id")))
+        lines.append([str(ln.get("id") or ""), c["qty"], c["rate"], c["total"], bool(ln.get("optional"))])
+    lines.sort(key=lambda r: r[0])
+    disc = est.get("discount") if isinstance(est.get("discount"), dict) else {}
+    tax = est.get("tax") if isinstance(est.get("tax"), dict) else {}
+    plan = est.get("payment_plan") if isinstance(est.get("payment_plan"), dict) else {}
+    items = None
+    if not lines:  # legacy quotes priced by `items`
+        items = sorted([str(i.get("name") or ""), _num(i.get("quantity")), _num(i.get("price") if i.get("price") is not None else i.get("rate"))]
+                       for i in (est.get("items") or []) if isinstance(i, dict))
+    sig = {
+        "lines": lines,
+        "items": items,
+        "discount": [bool(disc.get("enabled")), str(disc.get("type") or "percent"), _num(disc.get("value")) or 0.0] if disc.get("enabled") else None,
+        "tax": [tax.get("enabled") is not False, _num(tax.get("rate")), bool(tax.get("inclusive"))],
+        "payment_plan": [_num(plan.get("deposit_pct")), [_num(s.get("pct")) for s in (plan.get("stages") or []) if isinstance(s, dict)]] if plan else None,
+        "paint_charge": bool(est.get("paint_charge")),
+        "paint_tins": est.get("paint_tins") if est.get("paint_charge") else None,
+    }
+    return json.dumps(sig, sort_keys=True, default=str)
+
+
+async def _job_for(admin_id: str, estimate_id: str, *, db) -> dict | None:
+    return await db.projects.find_one({"owner_admin_id": admin_id, "estimate_id": estimate_id}, {"name": 1, "status": 1})
+
+
+async def _raised_invoice(admin_id: str, estimate_id: str, project_id: str | None, *, db) -> dict | None:
+    links: list[dict] = [{"estimate_id": estimate_id}] + ([{"project_id": project_id}] if project_id else [])
+    return await db.invoices.find_one({"owner_admin_id": admin_id, "status": {"$nin": list(RAISED_EXCLUDED)}, "$or": links}, {"number": 1, "status": 1, "amount_paid": 1})
+
+
+async def money_change_block(admin_id: str, existing: dict[str, Any], proposed: dict[str, Any], *, db=None) -> str | None:
+    if (existing.get("status") or "draft") != "accepted":
+        return None
+    if money_signature(existing) == money_signature(proposed):
+        return None
+    db = db or _db()
+    job = await _job_for(admin_id, existing["_id"], db=db)
+    inv = await _raised_invoice(admin_id, existing["_id"], (job or {}).get("_id"), db=db)
+    if not inv:
+        return None
+    num = existing.get("estimate_number") or "This quote"
+    paid = (_num(inv.get("amount_paid")) or 0) > 0
+    where = f" on the job «{job.get('name')}»" if job and job.get("name") else " on the job"
+    return (f"{num} is accepted and invoice {inv.get('number') or ''} has been {'paid' if paid else 'sent'} against it, so its prices, "
+            f"discount, GST and payment plan are locked. Price extra or changed work as a variation{where}.").replace("  ", " ")
+
+
+async def status_change_block(admin_id: str, cur: dict[str, Any], new_status: str, *, db=None) -> str | None:
+    cur_status = cur.get("status") or "draft"
+    if new_status == cur_status:
+        return None
+    if new_status == "archived" and cur_status == "accepted":
+        return "Accepted estimates can't be archived."
+    if new_status != "archived" and cur_status != "accepted":
+        return None
+    db = db or _db()
+    num = cur.get("estimate_number") or "This quote"
+    job = await _job_for(admin_id, cur["_id"], db=db)
+    inv = await _raised_invoice(admin_id, cur["_id"], (job or {}).get("_id"), db=db)
+    what = "archived" if new_status == "archived" else f"moved back to {STATUS_LABEL.get(new_status, new_status)}"
+    if job:
+        return f"{num} has the job «{job.get('name') or 'Untitled job'}», so it can't be {what}. Delete the job first if the acceptance was a mistake."
+    if inv:
+        return f"{num} has invoice {inv.get('number') or ''} raised against it, so it can't be {what}. Cancel or credit the invoice first.".replace("  ", " ")
+    return None
