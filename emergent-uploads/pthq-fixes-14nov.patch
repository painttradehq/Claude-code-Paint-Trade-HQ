new file mode 100644
index 0000000000000000000000000000000000000000..47675c4d6a7fc64b89e9621129aaca86102d2556
--- /dev/null
+++ b/backend/tests/test_fixj_quote_guard.py
@@ -0,0 +1,165 @@
+"""Fix Round J B-042 / B-044 — an accepted quote with a raised invoice keeps its money; an accepted quote with a job or a
+raised invoice keeps its status; nothing with a job or a raised invoice can be archived. No Mongo: a fake db."""
+import copy
+import os
+import sys
+
+import pytest
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from services.quote_guard import money_change_block, money_signature, status_change_block  # noqa: E402
+
+AID = "tenant-a"
+
+
+def _match(r, q):
+    for k, v in q.items():
+        if k == "$or":
+            if not any(_match(r, sub) for sub in v):
+                return False
+        elif isinstance(v, dict) and "$nin" in v:
+            if r.get(k) in v["$nin"]:
+                return False
+        elif r.get(k) != v:
+            return False
+    return True
+
+
