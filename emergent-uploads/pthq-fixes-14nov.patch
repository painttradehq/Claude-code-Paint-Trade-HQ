@@ -0,0 +1,31 @@
+"""Job pricing inputs — overhead % and the average crew cost the job money uses.
+
+Fix Round J B-003 / B-051 (11 Nov 2026). Settings › Quote setup › Pricing saves these as `estimate_defaults.overhead_pct`
+and `estimate_defaults.labor_hourly_rate`; the job money read a `pricing` section no screen ever wrote, so every job used
+3 % and $75/h whatever the owner had typed. Order: estimate_defaults → the legacy `pricing` section → the model defaults.
+Pure, no Mongo, so it is unit-tested on its own.
+"""
+from __future__ import annotations
+
+from typing import Any
+
+DEFAULT_OVERHEAD_PCT = 3.0
+DEFAULT_LABOR_HOURLY_RATE = 75.0
+
+
+def pricing_from_settings(doc: dict[str, Any] | None) -> dict[str, float]:
+    doc = doc or {}
+    sources = (doc.get("estimate_defaults") or {}, doc.get("pricing") or {})
+
+    def pick(key: str, default: float) -> float:
+        for src in sources:
+            v = src.get(key)
+            if v is None or (isinstance(v, str) and not v.strip()):
+                continue
+            try:
+                return float(v)
+            except (TypeError, ValueError):
+                continue
+        return default
+
+    return {"overhead_pct": pick("overhead_pct", DEFAULT_OVERHEAD_PCT), "labor_hourly_rate": pick("labor_hourly_rate", DEFAULT_LABOR_HOURLY_RATE)}
diff --git a/backend/services/quote_guard.py b/backend/services/quote_guard.py
