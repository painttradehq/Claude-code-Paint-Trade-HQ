@@ -0,0 +1,37 @@
+"""Fix Round K · B-074 / B-080 — undoing an acceptance (pure; run with --noconftest)."""
+from services.quote_unaccept import ACCEPTANCE_FIELDS, acceptance_unset, drafts_to_archive, invoices_to_relink
+
+
+def test_leaving_accepted_drops_the_stamp_the_signature_and_the_frozen_schedule():
+    unset = acceptance_unset("accepted", "draft")
+    assert set(unset) == set(ACCEPTANCE_FIELDS) == {"accepted_at", "signer_name", "signature_data_url", "signer_ip", "payment_schedule"}
+    assert acceptance_unset("accepted", "sent") and acceptance_unset("accepted", "on_hold")
+
+
+def test_every_other_status_change_touches_nothing():
+    for cur, new in (("draft", "sent"), ("sent", "accepted"), ("accepted", "accepted"), (None, "draft"), ("declined", "draft")):
+        assert acceptance_unset(cur, new) == {}
+
+
+def test_only_unsent_unpaid_drafts_are_archived():
+    invs = [
+        {"_id": "deposit-draft", "status": "draft"},
+        {"_id": "no-status"},
+        {"_id": "sent", "status": "sent", "sent_at": "2026-11-18"},
+        {"_id": "draft-again-after-send", "status": "draft", "sent_at": "2026-11-18"},
+        {"_id": "draft-with-money", "status": "draft", "amount_paid": 100},
+        {"_id": "draft-with-payment-row", "status": "draft", "payments": [{"amount": 50}]},
+        {"_id": "draft-with-voided-payment", "status": "draft", "payments": [{"amount": 50, "voided": True}]},
+        {"_id": "paid", "status": "paid", "amount_paid": 500},
+    ]
+    assert drafts_to_archive(invs) == ["deposit-draft", "no-status", "draft-with-voided-payment"]
+
+
+def test_the_quotes_invoices_follow_it_onto_the_new_job():
+    invs = [
+        {"_id": "unlinked", "project_id": None},
+        {"_id": "on-deleted-job", "project_id": "job-A"},     # INV-0013 after job A was deleted
+        {"_id": "on-live-job", "project_id": "job-other"},    # a job that still exists is left alone
+        {"_id": "already-here", "project_id": "job-B"},
+    ]
+    assert invoices_to_relink(invs, {"job-other", "job-B"}, "job-B") == ["unlinked", "on-deleted-job"]
