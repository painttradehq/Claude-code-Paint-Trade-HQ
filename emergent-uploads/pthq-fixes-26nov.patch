diff --git a/backend/services/quote_unaccept.py b/backend/services/quote_unaccept.py
new file mode 100644
index 0000000000000000000000000000000000000000..f7314f2022628dd75c7b3505a443bdd091a6691b
--- /dev/null
+++ b/backend/services/quote_unaccept.py
@@ -0,0 +1,34 @@
+"""Fix Round K · B-074 / B-080 — undoing an acceptance leaves nothing behind.
+
+A quote moved back from Accepted (only possible once its job is deleted and no invoice has been raised —
+services/quote_guard.py) kept accepted_at and the signature, kept its frozen payment schedule, and left the
+unsent deposit draft pointing at the deleted job. A second acceptance then built a new job that the old
+invoice never joined."""
+from __future__ import annotations
+
+from typing import Any
+
+# what an acceptance writes onto the quote; a quote that is no longer accepted carries none of it
+ACCEPTANCE_FIELDS = ("accepted_at", "signer_name", "signature_data_url", "signer_ip", "payment_schedule")
+
+
+def acceptance_unset(cur_status: str | None, new_status: str | None) -> dict[str, str]:
+    """The $unset for a status change that takes a quote out of Accepted (empty for every other change)."""
+    if (cur_status or "draft") == "accepted" and new_status and new_status != "accepted":
+        return dict.fromkeys(ACCEPTANCE_FIELDS, "")
+    return {}
+
+
+def drafts_to_archive(invoices: list[dict[str, Any]]) -> list[str]:
+    """Unsent drafts with no money on them — the deposit draft the acceptance raised by itself."""
+    out = []
+    for i in invoices:
+        paid = float(i.get("amount_paid") or 0) > 0 or any(not p.get("voided") for p in (i.get("payments") or []))
+        if (i.get("status") or "draft") == "draft" and not i.get("sent_at") and not paid:
+            out.append(i["_id"])
+    return out
+
+
+def invoices_to_relink(invoices: list[dict[str, Any]], live_job_ids: set[str], new_job_id: str) -> list[str]:
+    """The quote's invoices that belong on its new job: linked to no job, or to one that no longer exists."""
+    return [i["_id"] for i in invoices if i.get("project_id") != new_job_id and (not i.get("project_id") or i.get("project_id") not in live_job_ids)]
