--- /dev/null
+++ b/frontend/utils/greeting.ts
@@ -0,0 +1,19 @@
+/** Fix Round K · B-076 / B-079 — who an email says "Hi" to.
+ *  The greeting took the first word of the client's name, so a company client got "Hi Owners," (Owners Corporation …).
+ *  A person is greeted by first name; an organisation by the first name of its contact for that kind of document; otherwise "there". */
+const ORG = /\b(owners|corporation|corp|pty|ltd|limited|inc|incorporated|llc|plc|group|holdings|services|body\s+corporate|strata|council|school|college|university|church|trust|trustees?|club|association|society|committee|management|properties|property|builders|constructions?|developments?|real\s+estate|realty|agency|department|government|hotel|motel|cafe|restaurant|company|enterprises|partnership|clinic|foundation|maintenance|facilities|painting|painters|plumbing|electrical|joinery|carpentry)\b/i;
+
+export const looksLikeOrg = (name?: string | null): boolean => { const s = String(name || '').trim(); return !!s && (ORG.test(s) || /[&@\d/]/.test(s) || /^the\s/i.test(s)); };
+
+const firstWord = (name?: string | null): string => String(name || '').trim().split(/\s+/)[0] || '';
+
+type Contact = { name?: string; send_quotes?: boolean; send_invoices?: boolean };
+
+export function greetingName(clientName?: string | null, client?: { name?: string; contacts?: Contact[] } | null, kind: 'quotes' | 'invoices' = 'quotes'): string {
+  const name = client?.name || clientName;
+  if (!looksLikeOrg(name)) return firstWord(name) || 'there';
+  const people = (client?.contacts || []).filter((c) => c?.name && !looksLikeOrg(c.name));
+  const flag = kind === 'quotes' ? 'send_quotes' : 'send_invoices';
+  const pick = people.find((c) => c[flag]) || people[0];
+  return firstWord(pick?.name) || 'there';
+}
