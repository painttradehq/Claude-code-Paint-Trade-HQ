+"""Fix Round K · B-084 — About us prints only what the business typed (pure; run with --noconftest)."""
+import pathlib
+
+from services.about_us import about_parts
+
+
+def test_empty_settings_give_nothing():
+    assert about_parts({}) == ("", [])
+    assert about_parts(None) == ("", [])
+    assert about_parts({"about_us_blurb": "   ", "about_us_stats": []}) == ("", [])
+
+
+def test_typed_values_come_back_as_typed():
+    blurb, stats = about_parts({"about_us_blurb": " Painting Melbourne since 2019. ", "about_us_stats": [{"value": "$5M", "label": "Public liability"}]})
+    assert blurb == "Painting Melbourne since 2019."
+    assert stats == [{"value": "$5M", "label": "Public liability"}]
+
+
+def test_blank_and_broken_stats_are_dropped_and_four_is_the_cap():
+    raw = [{"value": "", "label": ""}, "junk", {"value": "A", "label": ""}, {"value": "", "label": "B"}, {"value": "C", "label": "c"}, {"value": "D", "label": "d"}, {"value": "E", "label": "e"}]
+    _, stats = about_parts({"about_us_stats": raw})
+    assert [s["value"] or s["label"] for s in stats] == ["A", "B", "C", "D"]
+
+
+def test_the_pdf_has_no_sample_claims_left():
+    src = (pathlib.Path(__file__).resolve().parents[1] / "services" / "pdf.py").read_text()
+    for sample in ("12+ yrs", "Reg. painter", "DEFAULT_STATS", "DEFAULT_ABOUT", "owner-operated painting crew", "def _default_terms", "We carry $20M", "warranted for 2 years"):
+        assert sample not in src
