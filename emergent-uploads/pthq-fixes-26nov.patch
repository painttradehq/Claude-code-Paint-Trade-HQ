+"""Fix Round K · B-065 / B-072 — zones with only a note, and the label on prep tasks (pure; run with --noconftest)."""
+from services.estimate_lines import client_document, flatten_estimate_lines, note_only_zones, task_label
+
+
+def _est():
+    return {
+        "areas": [
+            {"id": "a1", "name": "Front facade", "notes": "Work order #6944\nAccess via the side gate", "note_show_on_quote": True},
+            {"id": "a2", "name": "Rear deck", "notes": "", "note_show_on_quote": True},
+            {"id": "a3", "name": "Garage", "notes": "Office note only", "note_show_on_quote": False},
+            {"id": "a4", "name": "Eaves", "notes": "Two coats", "note_show_on_quote": True},
+        ],
+        "lines": [{"id": "l1", "area_id": "a4", "kind": "custom", "category": "labour", "name": "Paint eaves", "unit": "job", "qty": 1, "rate": 500}],
+        "tax": {"enabled": True, "rate": 10},
+    }
+
+
+def test_a_zone_with_a_shown_note_and_no_lines_is_kept():
+    zones = note_only_zones(_est())
+    assert [z["area_name"] for z in zones] == ["Front facade"]
+    assert zones[0]["area_note"] == "Work order #6944\nAccess via the side gate" and zones[0]["area_order"] == 0
+
+
+def test_a_zone_with_lines_an_empty_note_or_an_office_note_is_not_listed():
+    names = {z["area_name"] for z in note_only_zones(_est())}
+    assert not names & {"Rear deck", "Garage", "Eaves"}
+
+
+def test_the_client_copy_carries_them_and_rows_know_their_zone_order():
+    doc = client_document(_est(), {})
+    assert [z["area_id"] for z in doc["note_zones"]] == ["a1"]
+    assert doc["rows"][0]["area_order"] == 3
+    assert flatten_estimate_lines(_est(), {})[0]["area_note"] == "Two coats"
+
