new file mode 100644
index 0000000000000000000000000000000000000000..67826fc95497731ecf26aa8e05c512a4ace725ab
--- /dev/null
+++ b/backend/services/contract_fields.py
@@ -0,0 +1,53 @@
+"""Fix Round K · contracts — the casual fields and what an issue must carry.
+
+B-088 (contracts): [CASUAL LOADING] fills as a phrase (" including a 25% casual loading", written to sit straight
+after the rate) and stays that way so templates already written keep reading right. Two plain fields join it:
+[CASUAL LOADING PERCENT] → "25%" and [CASUAL HOURLY RATE] → the base rate plus the loading, a bare number like
+[HOURLY RATE]. All three are empty for an employee who is not a casual.
+B-087 (contracts): the notice period is asked for only when the employment template uses [NOTICE PERIOD]."""
+from __future__ import annotations
+
+from decimal import ROUND_HALF_UP, Decimal
+from typing import Any
+
+CASUAL_TOKENS = ("[CASUAL LOADING]", "[CASUAL LOADING PERCENT]", "[CASUAL HOURLY RATE]")
+
+
+def _num(v: Any) -> float | None:
+    try:
+        return float(str(v).replace("$", "").replace("%", "").replace(",", "").strip())
+    except (TypeError, ValueError):
+        return None
+
+
+def _trim(x: float) -> str:
+    return f"{x:.2f}".rstrip("0").rstrip(".")
+
+
+def casual_values(f: dict[str, Any] | None) -> dict[str, str]:
+    """The three casual tokens for these issue fields ('' when they don't apply or can't be worked out)."""
+    f = f or {}
+    out = dict.fromkeys(CASUAL_TOKENS, "")
+    loading = _num(f.get("loading"))
+    if (f.get("type") or "") != "Casual" or not loading:
+        return out
+    out["[CASUAL LOADING]"] = f" including a {_trim(loading)}% casual loading"
+    out["[CASUAL LOADING PERCENT]"] = f"{_trim(loading)}%"
+    rate = _num(f.get("rate"))
+    if rate is not None:
+        # in cents, halves rounded up (38.90 + 25% = 48.625 → 48.63) — the same arithmetic as src/utils/contractFill.ts
+        cents = Decimal(str(rate)) * 100
+        loaded = (cents.quantize(Decimal("1"), ROUND_HALF_UP) * (Decimal(100) + Decimal(str(loading))) / 100).quantize(Decimal("1"), ROUND_HALF_UP)
+        out["[CASUAL HOURLY RATE]"] = f"{loaded / 100:.2f}"
+    return out
+
+
+def required_issue_fields(f: dict[str, Any] | None, employment_template: str | None) -> list[str]:
+    """What must be filled before an Employment agreement is issued."""
+    f = f or {}
+    need = ["position", "type", "cls", "rate", "start"]
+    if "[NOTICE PERIOD]" in (employment_template or ""):
+        need.append("notice")
+    if f.get("type") != "Casual":
+        need.append("hours")
+    return need
