+"""Fix Round K · B-082 — reopening a job clears its completed date (pure; run with --noconftest)."""
+from services.job_status import clears_completed_date, reopened, reopened_message
+
+
+def test_done_back_to_in_progress_is_a_reopen():
+    assert reopened("done", "in_progress") and reopened("invoiced", "on_hold") and reopened("done", "quoted")
+    assert not reopened("in_progress", "on_hold") and not reopened("done", "invoiced") and not reopened("done", None)
+
+
+def test_the_completed_date_goes_when_the_job_is_reopened():
+    assert clears_completed_date("done", "in_progress", True, False)
+    assert clears_completed_date("invoiced", "in_progress", True, False)
+
+
+def test_a_stale_completed_date_on_an_unfinished_job_is_cleared_on_its_next_status_change():
+    # the South Wharf job: already in_progress with a completed date left behind
+    assert clears_completed_date("in_progress", "on_hold", True, False)
+
+
+def test_it_stays_when_the_job_stays_finished_or_the_save_sets_it():
+    assert not clears_completed_date("done", "invoiced", True, False)
+    assert not clears_completed_date("in_progress", "done", False, False)
+    assert not clears_completed_date("done", "in_progress", True, True)
+    assert not clears_completed_date("in_progress", "on_hold", False, False)
+    assert not clears_completed_date("done", None, True, False)
+
+
+def test_the_activity_line_names_the_new_status():
+    assert reopened_message("in_progress") == "Reopened — back to In progress; the completed date was cleared"
