new file mode 100644
index 0000000000000000000000000000000000000000..872048b8675b3200dcf873834686fb9304670603
--- /dev/null
+++ b/backend/services/about_us.py
@@ -0,0 +1,22 @@
+"""Fix Round K · B-084 — the About us block prints only what the business typed.
+
+The quote PDF used to fall back to a sample blurb and four sample stats ("12+ yrs", "$20M public
+liability", "2 yr warranty") when Quote setup › Quote PDF › About us was empty, so real quotes carried
+claims nobody made. There is no fallback any more: an empty About us prints nothing."""
+from __future__ import annotations
+
+from typing import Any
+
+
+def about_parts(business: dict[str, Any] | None) -> tuple[str, list[dict[str, str]]]:
+    """(blurb, stats) exactly as entered — a stat needs a value or a label; at most four."""
+    b = business or {}
+    blurb = str(b.get("about_us_blurb") or "").strip()
+    stats = []
+    for s in b.get("about_us_stats") or []:
+        if not isinstance(s, dict):
+            continue
+        value, label = str(s.get("value") or "").strip(), str(s.get("label") or "").strip()
+        if value or label:
+            stats.append({"value": value, "label": label})
+    return blurb, stats[:4]
diff --git a/backend/services/connector_quote_keys.py b/backend/services/connector_quote_keys.py
new file mode 100644
index 0000000000000000000000000000000000000000..9cc5ce3be6f074cce78c9199fc269d51bcdd27bb
--- /dev/null
+++ b/backend/services/connector_quote_keys.py
@@ -0,0 +1,64 @@
+"""Fix Round K · B-069 — the connector's update_quote says what it did with every key.
+
+A zone note sent as `note` (the quote stores it as `notes`) saved the zone and silently dropped the note; a
+custom line's labour sent as `mins` was dropped the same way (the quote stores `hours`). The plain aliases are
+now accepted, and any key the quote doesn't use comes back as a warning instead of vanishing."""
+from __future__ import annotations
+
+from typing import Any
+
+AREA_KEYS = {"id", "name", "width", "length", "height", "sqm", "notes", "note_show_on_quote", "order", "side"}
+LINE_KEYS = {"id", "area_id", "order", "kind", "category", "name", "unit", "qty", "qty_auto", "library", "coats", "primer", "prep", "prep_note", "prep_steps", "prep_extra", "prep_show",
+             "rate_override", "task", "hazard", "hazard_mode", "sub_cost", "markup_pct", "rate", "hours", "product_id", "pack", "paint", "colour", "notes", "note_show_on_quote", "photo_url", "optional",
+             # resolved by the connector before the save
+             "area", "library_item_id"}
+_MIN_KEYS = ("mins", "minutes", "labour_minutes", "labour_mins")
+
+
+def _note_alias(d: dict[str, Any]) -> None:
+    if "note" in d:
+        note = d.pop("note")
+        if not str(d.get("notes") or "").strip():
+            d["notes"] = note if isinstance(note, str) else ("" if note is None else str(note))
+
+
+def normalise(a: dict[str, Any]) -> tuple[dict[str, Any], list[str]]:
+    """(args with the aliases applied, warnings). Never raises; never drops a key the quote uses."""
+    out, warnings = dict(a), []
+    if isinstance(out.get("areas"), list):
+        areas = []
+        for i, area in enumerate(out["areas"]):
+            if not isinstance(area, dict):
+                areas.append(area)
+                continue
+            area = dict(area)
+            _note_alias(area)
+            unknown = sorted(k for k in area if k not in AREA_KEYS)
+            if unknown:
+                warnings.append(f"areas[{i}] ({area.get('name') or area.get('id') or 'unnamed'}): {', '.join(unknown)} — not a field a zone has; the zone's note is `notes`, shown to the client when `note_show_on_quote` is true")
+            areas.append(area)
+        out["areas"] = areas
+    if isinstance(out.get("lines"), list):
+        lines = []
+        for i, line in enumerate(out["lines"]):
+            if not isinstance(line, dict):
+                lines.append(line)
+                continue
+            line = dict(line)
+            _note_alias(line)
+            for k in _MIN_KEYS:
+                if k in line:
+                    mins = line.pop(k)
+                    if line.get("hours") is None and (line.get("kind") or "custom") == "custom":
+                        try:
+                            line["hours"] = round(float(mins) / 60, 4)
+                        except (TypeError, ValueError):
+                            warnings.append(f"lines[{i}] ({line.get('name') or 'unnamed'}): {k} is not a number")
+                    elif (line.get("kind") or "custom") != "custom":
+                        warnings.append(f"lines[{i}] ({line.get('name') or 'unnamed'}): {k} — a Library or task line takes its minutes from the Library; only a custom line carries its own labour (`hours`)")
+            unknown = sorted(k for k in line if k not in LINE_KEYS)
+            if unknown:
+                warnings.append(f"lines[{i}] ({line.get('name') or 'unnamed'}): {', '.join(unknown)} — not a field a line has; a custom line's labour is `hours`, its price `rate`, its note `notes`")
+            lines.append(line)
+        out["lines"] = lines
+    return out, warnings
