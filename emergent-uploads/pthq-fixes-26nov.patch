+"""Fix Round K · B-067 — the scope sits under the quote's charge (pure; run with --noconftest)."""
+from services.invoice_scope import attach_scope
+
+SCOPE = "Exterior repaint of the weatherboards, fascia and eaves.\nTwo coats, colours as selected."
+
+
+def test_a_stage_invoice_carries_the_scope_under_its_charge():
+    rows = attach_scope([{"id": "a", "name": "Deposit · 50% of quote EST-0037", "source_line_id": None}], "milestone", SCOPE)
+    assert rows[0]["scope"] == SCOPE
+
+
+def test_the_balance_invoice_does_too():
+    rows = attach_scope([{"id": "a", "name": "Final payment · remaining balance of quote EST-0037"}], "balance", SCOPE)
+    assert rows[0]["scope"] == SCOPE
+
+
+def test_it_goes_on_the_quote_charge_not_on_a_variation():
+    rows = attach_scope([{"id": "v", "name": "Variation · Extra door", "source_line_id": "variation:1"}, {"id": "a", "name": "Progress payment · 30% of quote EST-0037"}], "milestone", SCOPE)
+    assert "scope" not in rows[0] and rows[1]["scope"] == SCOPE
+
+
+def test_an_invoice_of_only_variations_gets_no_scope():
