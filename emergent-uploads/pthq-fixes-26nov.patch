+"""Fix Round K · B-083 — is the stored Google Drive folder still usable?
+
+The app remembered the id of its "Paint Trade HQ" folder from the day Drive was connected and kept writing
+into it after the owner had put that folder in the bin (and a new one existed), so quote PDFs and photos
+landed in the bin where Drive deletes them after 30 days. Every write now asks first."""
+from __future__ import annotations
+
+from typing import Any
+
+
+def folder_state(status_code: int, body: dict[str, Any] | None) -> str:
+    """'live' | 'gone' | 'unknown' from a Drive files.get answer (fields=id,trashed).
+    A folder inside a binned folder also reports trashed=true."""
+    if status_code == 200:
+        return "gone" if (body or {}).get("trashed") else "live"
+    if status_code == 404:
+        return "gone"
+    return "unknown"  # Drive hiccup or rate limit — not evidence the folder is gone
+
+
+def keep_stored(state: str) -> bool:
+    """Keep writing to the stored folder unless Drive says it is binned or deleted."""
+    return state != "gone"
