diff --git a/backend/services/invoice_scope.py b/backend/services/invoice_scope.py
new file mode 100644
index 0000000000000000000000000000000000000000..81944b561cb2eeacdefc3914157483a5a9fbc4c2
--- /dev/null
+++ b/backend/services/invoice_scope.py
@@ -0,0 +1,23 @@
+"""Fix Round K · B-067 — an invoice raised from a quote says what work the charge is for.
+
+The Job box carried the quote's scope summary while the charge line only said "Deposit · 50% of quote EST-0037",
+so the client could not see what they were paying for. Josh's layout: the Job box is the job (its type and the
+address); the scope sits under the charge, in the Description column. This applies when the invoice bills a stage
+or the balance of a quote — a full invoice already lists the quote's own lines."""
+from __future__ import annotations
+
+from typing import Any
+
+STAGE_KINDS = ("milestone", "balance")
+
+
+def attach_scope(rows: list[dict[str, Any]], kind: str | None, scope: str | None) -> list[dict[str, Any]]:
+    """Put the quote's scope under the first charge that comes from the quote itself (not an approved variation)."""
+    scope = (scope or "").strip()
+    if not scope or kind not in STAGE_KINDS:
+        return rows
+    for r in rows:
+        if not str(r.get("source_line_id") or "").startswith("variation:"):
+            r["scope"] = scope
+            break
+    return rows
diff --git a/backend/services/job_status.py b/backend/services/job_status.py
new file mode 100644
index 0000000000000000000000000000000000000000..0736833a19952b1610acce486af1179cbfa00bd0
--- /dev/null
+++ b/backend/services/job_status.py
@@ -0,0 +1,24 @@
+"""Fix Round K · B-082 — a job that is reopened is no longer 'completed'.
+
+Moving a job back from Done to In progress (or on hold) left its completed date behind, so reports and the
+crew app could still read it as finished on that day."""
+from __future__ import annotations
+
+FINISHED = ("done", "invoiced")
+LABEL = {"quoted": "Quoted", "in_progress": "In progress", "on_hold": "On hold", "done": "Done", "invoiced": "Invoiced"}
+
+
+def reopened(old_status: str | None, new_status: str | None) -> bool:
+    """True when a status change takes a finished job back to an unfinished state."""
+    return (old_status in FINISHED) and (new_status is not None) and (new_status not in FINISHED)
+
+
+def clears_completed_date(old_status: str | None, new_status: str | None, has_completed_date: bool, sends_completed_date: bool) -> bool:
+    """The completed date goes when the job leaves Done/Invoiced — or is unfinished but still carries one — unless this very save sets it."""
+    if sends_completed_date or new_status is None or new_status in FINISHED:
+        return False
+    return reopened(old_status, new_status) or has_completed_date
+
+
+def reopened_message(new_status: str) -> str:
+    return f"Reopened — back to {LABEL.get(new_status, new_status)}; the completed date was cleared"
