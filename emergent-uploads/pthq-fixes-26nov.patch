+"""Fix Round K · B-086 — an item priced by the hour has a price on the quote line (pure; run with --noconftest)."""
+from services.estimate_lines import library_minutes, library_rate
+from services.library_snapshot import snapshot
+
+HOURLY = {"_id": "v-hour", "name": "Labour – hourly", "category": "Labour", "pricedBy": "hour", "hourlyRate": 75, "rates": {}, "labourMins": {}}
+WALLS = {"_id": "v-walls", "category": "Walls", "pricedBy": "m2", "rates": {"primer": 4, "oneCoat": 9, "twoCoat": 14, "threeCoat": 18}, "labourMins": {"twoCoat": 6}, "prepRate": 2, "prepMinutes": 1}
+
+
+def test_an_hourly_item_carries_its_hourly_rate():
+    snap = snapshot(HOURLY)
+    assert snap["priced_by"] == "hour" and snap["rates"] == {"primer": None, "c1": 75.0, "c2": 75.0, "c3": 75.0}
+    assert snap["mins"]["c2"] == 60.0
+
+
+def test_the_quote_line_prices_from_it_whatever_the_coats():
+    for coats in (1, 2, 3):
+        line = {"kind": "library", "coats": coats, "library": snapshot(HOURLY)}
+        assert library_rate(line) == 75.0 and library_minutes(line) == 60.0
+
+
+def test_an_hourly_item_with_no_rate_typed_still_reads_as_no_price():
+    assert library_rate({"kind": "library", "coats": 2, "library": snapshot({**HOURLY, "hourlyRate": None})}) is None
+
+
+def test_a_square_metre_item_is_unchanged():
+    snap = snapshot(WALLS)
+    assert snap["rates"] == {"primer": 4.0, "c1": 9.0, "c2": 14.0, "c3": 18.0} and snap["mins"]["c2"] == 6.0 and snap["prep_rate"] == 2.0
+    assert library_rate({"kind": "library", "coats": 2, "primer": True, "prep": True, "library": snap}) == 20.0
+
+
+def test_a_stray_hourly_rate_on_a_non_hourly_item_is_ignored():
+    assert snapshot({**WALLS, "hourlyRate": 75})["rates"]["c2"] == 14.0
