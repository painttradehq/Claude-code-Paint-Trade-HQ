+"""Fix Round K · B-075 — a job-only session fix is not refused over its times (pure; run with --noconftest)."""
+from datetime import datetime
+
+from services.session_fix import MESSAGE, times_error
+
+T = datetime(2026, 11, 17, 16, 33)
+
+
+def test_job_only_change_on_a_session_still_on_the_clock():
+    assert times_error(None, None, T, None) is None
+
+
+def test_job_only_change_on_a_zero_hour_session():
+    assert times_error(None, None, T, T) is None
+
+
+def test_a_changed_time_is_still_checked():
+    assert times_error(T, T, T, T) == MESSAGE
+    assert times_error(None, datetime(2026, 11, 17, 15, 0), T, datetime(2026, 11, 17, 15, 0)) == MESSAGE
+    assert times_error(T, datetime(2026, 11, 17, 17, 0), T, datetime(2026, 11, 17, 17, 0)) is None
+
+
+def test_moving_the_sign_in_of_an_open_session_keeps_it_open():
+    assert times_error(datetime(2026, 11, 17, 7, 0), None, datetime(2026, 11, 17, 7, 0), None) is None
diff --git a/backend/tests/test_fixk_terms_parse.py b/backend/tests/test_fixk_terms_parse.py
new file mode 100644
index 0000000000000000000000000000000000000000..238e2c046f7f62b0b5c2d484a7b1bbe3b9a932a6
--- /dev/null
+++ b/backend/tests/test_fixk_terms_parse.py
@@ -0,0 +1,53 @@
+"""Fix Round K · B-064 — a heading line and the paragraph under it are one clause (pure; run with --noconftest)."""
+from services.terms_parse import parse
+
+HEADING_FORMAT = """1. Your quote
+Your quote covers only the work described in it. Anything else is a variation.
+
+2. Payment
+A deposit is payable on acceptance. The balance is due on completion.
+Late payments attract interest at 10% a year.
+
+3. Warranty
+We warrant our workmanship for five years.
+"""
+
+
+def test_heading_plus_paragraph_is_one_clause_each():
+    out = parse(HEADING_FORMAT)
+    assert [c["t"] for c in out] == ["Your quote", "Payment", "Warranty"]
+    assert out[0]["d"].startswith("Your quote covers only the work") and "Note" not in [c["t"] for c in out]
+    assert out[1]["d"] == "A deposit is payable on acceptance. The balance is due on completion. Late payments attract interest at 10% a year."
+
+
+def test_unnumbered_short_headings_work_too():
+    out = parse("Workmanship warranty\nAll labour is warranted against defective preparation or application.\n\nCancellations\nCancellations within 48 hours may forfeit the deposit.")
+    assert [(c["t"], c["d"][:12]) for c in out] == [("Workmanship warranty", "All labour i"), ("Cancellations", "Cancellation")]
+
+
+def test_title_colon_text_on_one_line_is_unchanged():
+    out = parse("Quote validity: This quote is valid for 30 days.\n2. Payment — A deposit secures your start date.\nSite conduct - We keep the site tidy.")
+    assert out == [{"t": "Quote validity", "d": "This quote is valid for 30 days."}, {"t": "Payment", "d": "A deposit secures your start date."}, {"t": "Site conduct", "d": "We keep the site tidy."}]
+
+
+def test_the_two_formats_can_be_mixed():
+    out = parse("Validity: 30 days from the date above.\n\nAccess\nPlease clear the work areas before we start.")
+    assert [c["t"] for c in out] == ["Validity", "Access"]
+
+
+def test_a_plain_paragraph_with_no_heading_keeps_the_note_title():
+    assert parse("We keep the site tidy and clean up at the end of each day.") == [{"t": "Note", "d": "We keep the site tidy and clean up at the end of each day."}]
+
+
+def test_two_short_untitled_sentences_are_not_glued_together():
+    out = parse("Payment is due within 7 days of the invoice\nAll work is guaranteed for five years from completion.")
+    assert len(out) == 2 and all(c["t"] == "Note" for c in out)
+
+
+def test_a_heading_with_nothing_under_it_is_not_lost():
+    out = parse("Payment\n\n")
+    assert out == [{"t": "Note", "d": "Payment"}]
+
+
+def test_empty_text_gives_no_clauses():
+    assert parse("") == [] and parse(None) == [] and parse("\n \n") == []
diff --git a/backend/tests/test_fixk_variation_money.py b/backend/tests/test_fixk_variation_money.py
new file mode 100644
index 0000000000000000000000000000000000000000..df012990a363767ef3d9a5dcc0e261da02750e57
--- /dev/null
+++ b/backend/tests/test_fixk_variation_money.py
@@ -0,0 +1,74 @@
+"""Fix Round K · B-085 / B-087 / B-088 — variation money and the draft edit (pure; run with --noconftest)."""
+import pytest
+
+from services import variation_money as vm
+
+ADDS_GST = {"enabled": True, "rate": 10, "inclusive": False}
+INCLUDES_GST = {"enabled": True, "rate": 10, "inclusive": True}
+NO_GST = {"enabled": False, "rate": 10}
+
+
+def test_a_quote_that_adds_gst_makes_the_variation_ex_gst():
+    assert vm.stamp(320, ADDS_GST) == {"gst_mode": "exclusive", "gst_rate": 10.0, "total": 352.0}
+
+
+def test_a_quote_whose_prices_include_gst_keeps_the_price_as_the_total():
+    assert vm.stamp(320, INCLUDES_GST) == {"gst_mode": "inclusive", "gst_rate": 10.0, "total": 320.0}
+
+
+def test_no_gst_on_the_quote_no_gst_on_the_variation():
+    assert vm.stamp(320, NO_GST) == {"gst_mode": "none", "gst_rate": 0.0, "total": 320.0}
+    assert vm.stamp(320, {"enabled": True, "rate": 0})["gst_mode"] == "none"
+
+
+def test_a_missing_tax_block_reads_as_gst_on_top_at_ten_percent():
+    assert vm.stamp(100, None) == {"gst_mode": "exclusive", "gst_rate": 10.0, "total": 110.0}
+
+
+def test_quote_setup_defaults_stand_in_for_a_job_with_no_quote():
+    assert vm.gst_mode_for(vm.tax_from_defaults({"tax_rate": 10, "prices_include_tax": True})) == ("inclusive", 10.0)
+    assert vm.gst_mode_for(vm.tax_from_defaults({"tax_enabled_by_default": False})) == ("none", 0.0)
+    assert vm.gst_mode_for(vm.tax_from_defaults(None)) == ("exclusive", 10.0)
+
+
+def test_the_bill_reads_the_total_and_old_variations_keep_their_price():
+    assert vm.amount({"price": 320, "total": 352.0}) == 352.0
+    assert vm.amount({"price": 320}) == 320.0  # made before the stamp: no backfill
+
+
+def test_the_client_is_never_shown_a_bare_ex_gst_price():
+    assert vm.price_text({"price": 320, **vm.stamp(320, ADDS_GST)}) == "$320.00 + GST ($352.00 incl. GST)"
+    assert vm.price_text({"price": 320, **vm.stamp(320, INCLUDES_GST)}) == "$320.00 incl. GST"
+    assert vm.price_text({"price": 1320.5}) == "$1,320.50"
+
+
+def test_the_invoice_line_comes_out_at_the_ex_gst_price():
+    # invoice_lines.variation_line backs GST out of the amount: 352 / 1.1 = 320, then GST is added again
+    v = {"price": 320, **vm.stamp(320, ADDS_GST)}
+    assert round(vm.amount(v) / 1.1, 2) == 320.0
+
+
+def test_a_draft_takes_only_the_fields_sent_and_is_restamped():
+    v = {"id": "v1", "status": "draft", "title": "Extra door", "description": "Prep and two coats", "price": 320, "lines": [{"name": "Door"}], **vm.stamp(320, ADDS_GST)}
+    out = vm.apply_edit(v, {"price": 400, "title": "  Extra doors  "}, ADDS_GST)
+    assert out["title"] == "Extra doors" and out["price"] == 400.0 and out["total"] == 440.0
+    assert out["description"] == "Prep and two coats" and out["lines"] == [{"name": "Door"}] and out["id"] == "v1"
+
+
+def test_a_cleared_text_field_is_stored_empty():
+    v = {"status": "draft", "title": "A", "price": 10, "notes": "old"}
+    assert vm.apply_edit(v, {"notes": ""}, NO_GST)["notes"] is None
+
+
+@pytest.mark.parametrize("status", ["sent", "approved", "declined"])
+def test_a_sent_or_answered_variation_cannot_be_changed(status):
+    with pytest.raises(ValueError, match="Only a draft"):
+        vm.apply_edit({"status": status, "title": "A", "price": 10}, {"price": 20}, ADDS_GST)
+
+
+def test_an_edit_cannot_blank_the_title_or_zero_the_price():
+    v = {"status": "draft", "title": "A", "price": 10}
+    with pytest.raises(ValueError, match="Title"):
+        vm.apply_edit(v, {"title": "  "}, NO_GST)
+    with pytest.raises(ValueError, match="Price"):
+        vm.apply_edit(v, {"price": 0}, NO_GST)
