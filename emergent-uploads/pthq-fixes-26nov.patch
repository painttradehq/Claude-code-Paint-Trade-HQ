+"""The snapshot of a Library item that a quote line carries (rates and labour minutes by coats).
+
+Fix Round K · B-086 — an item priced by the hour keeps its price in `hourlyRate`, not in the coat rates, so
+its snapshot came out with every rate empty and the line read "no price" at $0. An hourly item now carries
+its hourly rate on every coat slot (coats don't apply to an hour of labour) and 60 labour minutes a unit."""
+from __future__ import annotations
+
+from typing import Any
+
+_UNITS = {"m2": "m2", "sqm": "m2", "lm": "lineal", "lineal": "lineal", "each": "each", "ea": "each", "hour": "hour", "hr": "hour"}
+
+
+def _opt(x: Any) -> float | None:
+    if x in (None, ""):
+        return None
+    try:
+        return float(x)
+    except (TypeError, ValueError):
+        return None
+
+
+def snapshot(v: dict[str, Any]) -> dict[str, Any]:
+    rates, mins = v.get("rates") or {}, v.get("labourMins") or {}
+    unit = _UNITS.get(str(v.get("pricedBy") or "m2").lower(), "m2")
+    out_rates = {"primer": _opt(rates.get("primer")), "c1": _opt(rates.get("oneCoat")), "c2": _opt(rates.get("twoCoat")), "c3": _opt(rates.get("threeCoat"))}
+    out_mins = {"primer": _opt(mins.get("primer")), "c1": _opt(mins.get("oneCoat")), "c2": _opt(mins.get("twoCoat")), "c3": _opt(mins.get("threeCoat"))}
+    hourly = _opt(v.get("hourlyRate"))
+    if unit == "hour" and hourly is not None:
+        out_rates = {"primer": None, "c1": hourly, "c2": hourly, "c3": hourly}
+        out_mins = {"primer": None, **{k: (out_mins[k] if out_mins[k] is not None else 60.0) for k in ("c1", "c2", "c3")}}
+    return {"variant_id": v.get("_id") or v.get("id"), "category": v.get("category") or "", "priced_by": unit, "rates": out_rates, "mins": out_mins,
+            "prep_rate": _opt(v.get("prepRate")), "prep_mins": _opt(v.get("prepMinutes"))}
