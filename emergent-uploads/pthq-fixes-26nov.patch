--- /dev/null
+++ b/backend/tests/test_fixk_contract_fields.py
@@ -0,0 +1,43 @@
+"""Fix Round K · contracts B-087 / B-088 — casual fields and the notice period (pure; run with --noconftest)."""
+from services.contract_fields import CASUAL_TOKENS, casual_values, required_issue_fields
+
+
+def test_a_casual_gets_the_phrase_the_percent_and_the_loaded_rate():
+    v = casual_values({"type": "Casual", "loading": "25", "rate": "38.90"})
+    assert v == {"[CASUAL LOADING]": " including a 25% casual loading", "[CASUAL LOADING PERCENT]": "25%", "[CASUAL HOURLY RATE]": "48.63"}  # 48.625 rounds up
+
+
+def test_the_loaded_rate_is_base_times_one_plus_loading():
+    assert casual_values({"type": "Casual", "loading": 25, "rate": 40})["[CASUAL HOURLY RATE]"] == "50.00"
+    assert casual_values({"type": "Casual", "loading": "12.5", "rate": "$32"})["[CASUAL HOURLY RATE]"] == "36.00"
+    assert casual_values({"type": "Casual", "loading": "12.5", "rate": "32"})["[CASUAL LOADING PERCENT]"] == "12.5%"
+
+
+def test_the_old_phrase_reads_the_same_as_before():
+    # "$[HOURLY RATE] per hour[CASUAL LOADING]." is how templates were written for it
+    assert f"$38.90 per hour{casual_values({'type': 'Casual', 'loading': '25', 'rate': '38.90'})['[CASUAL LOADING]']}." == "$38.90 per hour including a 25% casual loading."
+
+
+def test_a_non_casual_or_no_loading_leaves_all_three_empty():
+    empty = dict.fromkeys(CASUAL_TOKENS, "")
+    assert casual_values({"type": "Full-time", "loading": "25", "rate": "38.90"}) == empty
+    assert casual_values({"type": "Casual", "loading": "", "rate": "38.90"}) == empty
+    assert casual_values(None) == empty
+
+
+def test_a_rate_that_is_not_a_number_leaves_the_loaded_rate_unresolved():
+    v = casual_values({"type": "Casual", "loading": "25", "rate": "award rate"})
+    assert v["[CASUAL HOURLY RATE]"] == "" and v["[CASUAL LOADING PERCENT]"] == "25%"
+
+
+def test_notice_is_asked_only_when_the_template_uses_it():
+    with_notice = "Either party may end this agreement with [NOTICE PERIOD] notice."
+    assert "notice" in required_issue_fields({"type": "Full-time"}, with_notice)
+    assert "notice" in required_issue_fields({"type": "Casual"}, with_notice)
+    assert "notice" not in required_issue_fields({"type": "Casual"}, "Casual employment. $[HOURLY RATE] per hour[CASUAL LOADING].")
+    assert "notice" not in required_issue_fields({"type": "Full-time"}, None)
+
+
+def test_hours_are_asked_for_everyone_but_a_casual():
+    assert "hours" in required_issue_fields({"type": "Part-time"}, "") and "hours" not in required_issue_fields({"type": "Casual"}, "")
+    assert required_issue_fields({"type": "Casual"}, "")[:5] == ["position", "type", "cls", "rate", "start"]
