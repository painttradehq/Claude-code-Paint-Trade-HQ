+"""Fix Round K · B-075 — fixing a session checks the times only when a time is being changed.
+
+"Fix this session" refused a job-only change on a session still on the clock, and on a 0-hour session
+(4:33 pm → 4:33 pm), with "Sign-out must be after sign-in" — a rule about times neither edit touched."""
+from __future__ import annotations
+
+from datetime import datetime
+
+MESSAGE = "Sign-out must be after sign-in"
+
+
+def times_error(sent_in: datetime | None, sent_out: datetime | None, new_in: datetime, new_out: datetime | None) -> str | None:
+    """None when the edit may stand. `sent_*` are the times this request carries; `new_*` what the session would hold."""
+    if sent_in is None and sent_out is None:
+        return None  # job or reason only — the stored times are not this edit's business
+    if new_out is not None and new_out <= new_in:
+        return MESSAGE
+    return None
diff --git a/backend/services/terms_parse.py b/backend/services/terms_parse.py
new file mode 100644
index 0000000000000000000000000000000000000000..7c57e1380282ef66a39b8622bf68f0f386ae4f15
--- /dev/null
+++ b/backend/services/terms_parse.py
@@ -0,0 +1,67 @@
+"""Quote terms: the template text → the numbered clauses the client sees.
+
+Fix Round K · B-064 — every line used to be its own clause, and a line without "Title: text" was titled
+"Note", so a template written as a heading with its paragraph underneath came out as twice as many clauses
+with "Note" for every paragraph ("1. Note 1. Your quote", "2. Note Your quote covers only…"). A short heading
+line now takes the paragraph(s) under it as its text. "Title: text" on one line works as before."""
+from __future__ import annotations
+
+import re
+
+_NUM = re.compile(r"^\s*(?:\d+[.)]|[(]\d+[)])\s*")
+_SEPS = (" — ", " – ", " - ", ": ")
+_END = (".", ";", ",", "?", "!")
+
+
+def _strip_num(s: str) -> str:
+    return _NUM.sub("", s).strip()
+
+
+def _titled(line: str) -> tuple[str, str] | None:
+    """('Title', 'text') when the line is "Title: text" / "Title — text" (title under 60 characters)."""
+    for sep in _SEPS:
+        if sep in line:
+            head, tail = line.split(sep, 1)
+            head = _strip_num(head)
+            if head and len(head) < 60 and tail.strip():
+                return head, tail.strip()
+    return None
+
+
+def _heading(line: str) -> str | None:
+    """The title when the line is a heading on its own: "3. Payment", "Workmanship warranty", "PAYMENT TERMS:"."""
+    numbered = bool(_NUM.match(line))
+    text = _strip_num(line).rstrip(":").strip()
+    if not text or text.endswith(_END):
+        return None
+    words = len(text.split())
+    if numbered and len(text) <= 60 and words <= 9:
+        return text
+    if len(text) <= 40 and words <= 5:
+        return text
+    return None
+
+
+def parse(raw: str) -> list[dict[str, str]]:
+    """[{t: title, d: text}] — never raises; an untitled stand-alone paragraph keeps the old "Note" title."""
+    lines = [ln.strip() for ln in str(raw or "").replace("\r\n", "\n").replace("\r", "\n").split("\n")]
+    lines = [ln for ln in lines if ln]
+    out: list[dict[str, str]] = []
+    open_heading = False  # the last clause was started by a heading line and still takes paragraphs
+    for i, line in enumerate(lines):
+        titled = _titled(line)
+        if titled:
+            out.append({"t": titled[0], "d": titled[1]})
+            open_heading = False
+            continue
+        nxt = lines[i + 1] if i + 1 < len(lines) else None
+        head = _heading(line)
+        if head and nxt is not None and not _titled(nxt) and not _heading(nxt):
+            out.append({"t": head, "d": ""})
+            open_heading = True
+            continue
+        if open_heading:
+            out[-1]["d"] = f"{out[-1]['d']} {line}".strip()
+            continue
+        out.append({"t": "Note", "d": line})
+    return out
diff --git a/backend/services/variation_money.py b/backend/services/variation_money.py
new file mode 100644
index 0000000000000000000000000000000000000000..778bacdc15f02a8f1a7ec5cffe5c8fbe52223b26
--- /dev/null
+++ b/backend/services/variation_money.py
@@ -0,0 +1,92 @@
+"""Fix Round K · B-087 — a variation is priced the same way as the job's quote.
+
+A variation is built from the Library like a quote, so on a job whose quote adds GST on top its price is
+ex-GST. It used to be stored as one bare number that every bill treated as GST-inclusive, so an approved
+$320 variation reached the invoice as $290.91 + GST. Now the variation is stamped when it is made:
+
+    gst_mode   "exclusive"  the quote adds GST on top   → total = price × (1 + rate)
+               "inclusive"  the quote's prices include GST → total = price
+               "none"       no GST on the quote            → total = price
+    total      what the client pays, GST included — the figure every bill and job total reads
+
+Variations made before this have no stamp and keep their old reading (price = the amount billed). No backfill."""
+from __future__ import annotations
+
+from typing import Any
+
+
+def _num(v: Any, default: float = 0.0) -> float:
+    try:
+        return float(v)
+    except (TypeError, ValueError):
+        return default
+
+
+def gst_mode_for(tax: dict[str, Any] | None) -> tuple[str, float]:
+    """(mode, rate) from a quote's tax block ({enabled, rate, inclusive})."""
+    t = tax or {}
+    if not t.get("enabled", True):
+        return "none", 0.0
+    rate = _num(t.get("rate"), 10.0)
+    if rate <= 0:
+        return "none", 0.0
+    return ("inclusive" if t.get("inclusive") else "exclusive"), rate
+
+
+def tax_from_defaults(estimate_defaults: dict[str, Any] | None) -> dict[str, Any]:
+    """The tax block a new quote would get — used for a job that has no quote."""
+    ed = estimate_defaults or {}
+    return {"enabled": ed.get("tax_enabled_by_default", True) is not False, "rate": _num(ed.get("tax_rate"), 10.0) if ed.get("tax_rate") is not None else 10.0,
+            "inclusive": bool(ed.get("prices_include_tax"))}
+
+
+def stamp(price: float, tax: dict[str, Any] | None) -> dict[str, Any]:
+    mode, rate = gst_mode_for(tax)
+    price = round(_num(price), 2)
+    total = round(price * (1 + rate / 100), 2) if mode == "exclusive" else price
+    return {"gst_mode": mode, "gst_rate": rate, "total": total}
+
+
+def amount(v: dict[str, Any]) -> float:
+    """What the client pays for this variation, GST included (old variations: the price as it was)."""
+    return round(_num(v.get("total") if v.get("total") is not None else v.get("price")), 2)
+
+
+def price_text(v: dict[str, Any]) -> str:
+    """How the price is said to the client and in the job's activity: never a bare ex-GST figure."""
+    price = _num(v.get("price"))
+    mode = v.get("gst_mode")
+    if mode == "exclusive":
+        return f"${price:,.2f} + GST (${amount(v):,.2f} incl. GST)"
+    if mode == "inclusive":
+        return f"${price:,.2f} incl. GST"
+    return f"${price:,.2f}"
+
+
+EDITABLE = ("title", "description", "price", "timeframe", "area", "notes", "lines")
+
+
+def apply_edit(v: dict[str, Any], changes: dict[str, Any], tax: dict[str, Any] | None) -> dict[str, Any]:
+    """Fix Round K B-085 — a draft variation takes the fields that were sent (others stay), then is re-stamped.
+    Raises ValueError with the sentence to show when the edit can't stand."""
+    if (v.get("status") or "draft") != "draft":
+        raise ValueError("Only a draft variation can be changed. Once it is sent, delete it and draft a new one.")
+    out = dict(v)
+    for k in EDITABLE:
+        if k not in changes:
+            continue
+        val = changes[k]
+        if k == "price":
+            out[k] = round(_num(val), 2)
+        elif k == "lines":
+            out[k] = list(val or [])
+        elif k == "title":
+            out[k] = str(val or "").strip()
+        else:
+            out[k] = (str(val).strip() if val is not None else "") or None
+    if not out.get("title"):
+        raise ValueError("Title is required")
+    if _num(out.get("price")) <= 0:
+        raise ValueError("Price must be > 0")
+    out.update(stamp(out["price"], tax))
+    return out
