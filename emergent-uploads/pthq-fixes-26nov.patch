+"""Fix Round K · B-069 — update_quote keeps a zone note and reports what it can't place (pure; run with --noconftest)."""
+from services.connector_quote_keys import normalise
+
+
+def test_a_zone_note_sent_as_note_is_saved_as_notes():
+    a, w = normalise({"id": "q1", "areas": [{"id": "a1", "name": "Front", "note": "Scaffold on the east side", "note_show_on_quote": True}]})
+    assert a["areas"][0] == {"id": "a1", "name": "Front", "notes": "Scaffold on the east side", "note_show_on_quote": True} and w == []
+
+
+def test_notes_wins_when_both_are_sent():
+    a, _ = normalise({"areas": [{"name": "Front", "note": "old", "notes": "the real one"}]})
+    assert a["areas"][0]["notes"] == "the real one" and "note" not in a["areas"][0]
+
+
+def test_a_custom_lines_minutes_become_hours():
+    a, w = normalise({"lines": [{"name": "Access and clearing", "kind": "custom", "mins": 90, "rate": 150}]})
+    assert a["lines"][0]["hours"] == 1.5 and "mins" not in a["lines"][0] and w == []
+
+
+def test_typed_hours_are_not_overwritten_and_library_lines_say_why_minutes_are_ignored():
+    a, w = normalise({"lines": [{"name": "A", "hours": 2, "minutes": 30}, {"name": "Walls", "kind": "library", "mins": 30}]})
+    assert a["lines"][0]["hours"] == 2 and "hours" not in a["lines"][1]
+    assert len(w) == 1 and "takes its minutes from the Library" in w[0]
+
+
+def test_unknown_keys_are_reported_not_swallowed():
+    a, w = normalise({"areas": [{"name": "Front", "comment": "x"}], "lines": [{"name": "A", "labour": 3, "area": "Front", "library_item_id": "v1"}]})
+    assert a["areas"][0]["comment"] == "x"  # nothing is dropped here; the warning says it is not used
+    assert any("areas[0] (Front): comment" in x for x in w) and any("lines[0] (A): labour" in x for x in w)
+    assert not any("library_item_id" in x or "area," in x for x in w)
+
+
+def test_everything_the_builder_itself_sends_passes_without_a_warning():
+    line = {"id": "l1", "area_id": "a1", "order": 0, "kind": "library", "category": "labour", "name": "Walls", "unit": "m2", "qty": None, "qty_auto": True, "library": {}, "coats": 2, "primer": False,
+            "prep": True, "prep_note": None, "prep_steps": [], "prep_extra": "", "prep_show": True, "rate_override": None, "product_id": None, "pack": None, "paint": None, "colour": "", "notes": "", "note_show_on_quote": False, "photo_url": None, "optional": False}
+    area = {"id": "a1", "name": "Lounge", "width": 4, "length": 5, "height": 2.7, "sqm": 0, "notes": "", "note_show_on_quote": False, "order": 0, "side": "interior"}
+    assert normalise({"areas": [area], "lines": [line]})[1] == []
+
+
+def test_args_without_areas_or_lines_pass_through():
+    assert normalise({"id": "q1", "notes": "internal"}) == ({"id": "q1", "notes": "internal"}, [])
diff --git a/backend/tests/test_fixk_contract_fields.py b/backend/tests/test_fixk_contract_fields.py
