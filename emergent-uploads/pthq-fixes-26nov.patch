@@ -0,0 +1,30 @@
+"""Fix Round K · B-083 — writes never go to a binned Drive folder (pure; run with --noconftest)."""
+import pathlib
+
+from services.drive_root import folder_state, keep_stored
+
+
+def test_a_live_folder_is_kept():
+    assert folder_state(200, {"id": "x", "trashed": False}) == "live"
+    assert keep_stored("live")
+
+
+def test_a_binned_folder_is_dropped():
+    assert folder_state(200, {"id": "x", "trashed": True}) == "gone"
+    assert not keep_stored("gone")
+
+
+def test_a_deleted_folder_is_dropped():
+    assert folder_state(404, {"error": {}}) == "gone"
+
+
+def test_a_drive_hiccup_is_not_evidence_the_folder_is_gone():
+    for code in (401, 403, 429, 500, 503):
+        assert folder_state(code, None) == "unknown"
+    assert keep_stored("unknown")
+
+
+def test_every_write_path_resolves_the_root_through_the_check():
+    src = (pathlib.Path(__file__).resolve().parents[1] / "routes" / "google_drive.py").read_text()
+    assert src.count("await _root_folder(client, token, admin_id") == 3  # upload, organise, ensure path
+    assert 'doc.get("root_folder_id") or await _find_or_create_folder' not in src
